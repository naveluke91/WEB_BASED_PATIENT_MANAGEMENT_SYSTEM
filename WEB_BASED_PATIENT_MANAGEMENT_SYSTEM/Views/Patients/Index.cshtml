@model IEnumerable<WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.Patient>
@{
    ViewData["Title"] = "Patients";
    var totalCount = Model.Count();
    var openEditPatientId = TempData["OpenEditModalId"]?.ToString();
}

@section Styles {
    <link rel="stylesheet" href="~/css/patient/patient.css" asp-append-version="true" />
}

<!-- Page header -->
<div class="page-header">
    <div class="page-heading">
        <h1>Patients</h1>
    </div>
    <div class="page-actions">
        <button type="button" class="btn-primary-dark" data-bs-toggle="modal" data-bs-target="#modalAddPatient">
            <i class="bi bi-person-plus" aria-hidden="true"></i> Add New Patient
        </button>
    </div>
</div>

<partial name="_PageAlerts" />

<!-- Patient list card -->
<div class="content-card">
    <div class="card-header-row">
        <h2 class="card-title">Patient List</h2>
        <!-- Search patients by name, ID, or contact -->
        <div class="search-box">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="text" id="patientSearch" placeholder="Search patients by name, ID or contact." aria-label="Search patients" />
        </div>
    </div>

    <!-- Patient data table -->
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Patient Name</th>
                    <th class="col-fit">Age</th>
                    <th>Contact</th>
                    <th>Age of Gestation (AOG)</th>
                    <th>Estimated Date of Confinement (EDC)</th>
                    <th class="col-actions">Action</th>
                </tr>
            </thead>
            <tbody id="patientTableBody">
                @if (totalCount == 0)
                {
                    <tr>
                        <td colspan="6" class="table-empty">No patients found.</td>
                    </tr>
                }
                @foreach (var patient in Model)
                {
                    <tr class="patient-row"
                        data-name="@patient.FullName.ToLower()"
                        data-contact="@patient.ContactNo"
                        data-id="@patient.Id">
                        <td class="cell-name">@patient.FullName</td>
                        <td class="col-fit">@patient.Age</td>
                        <td class="cell-nowrap cell-center">@patient.ContactNo</td>
                        <td class="cell-center">
                            @if (!string.IsNullOrEmpty(patient.AOG))
                            {
                                <span class="aog-highlight">@patient.AOG</span>
                            }
                        </td>
                        <td class="cell-nowrap cell-center">@(patient.EDC?.ToString("MMMM dd, yyyy") ?? "—")</td>
                        <td class="col-actions">
                            <div class="action-btns">
                                <!-- View details in modal -->
                                <button type="button" class="action-btn" title="View Details"
                                        aria-label="View details of @patient.FullName"
                                        onclick="openPatientDetailsModal(@patient.Id)">
                                    <i class="bi bi-eye" aria-hidden="true"></i><span class="action-label">View</span>
                                </button>

                                <!-- Edit patient in modal -->
                                <button type="button" class="action-btn" title="Edit"
                                        aria-label="Edit @patient.FullName"
                                        onclick="openPatientEditModal(@patient.Id)">
                                    <i class="bi bi-pencil" aria-hidden="true"></i><span class="action-label">Edit</span>
                                </button>

                                <!-- Delete patient with JS confirm -->
                                <form asp-action="Delete" asp-route-id="@patient.Id" method="post" onsubmit="confirmDelete(event, this);" data-delete-message="Delete this patient and all related services, appointments, consultations, and medical records? This cannot be undone.">
                                    <button type="submit" class="action-btn delete-btn" title="Delete"
                                            aria-label="Delete @patient.FullName">
                                        <i class="bi bi-trash" aria-hidden="true"></i><span class="action-label">Delete</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Pagination — commented out for now
    <div class="pagination-row">
        <span id="paginationInfo">Showing 1 to @totalCount of @totalCount patients</span>
        <div class="pagination-controls">
            <button class="page-btn"><i class="bi bi-chevron-left"></i></button>
            <button class="page-btn active">1</button>
            <button class="page-btn">2</button>
            <button class="page-btn">3</button>
            <span class="pagination-ellipsis">...</span>
            <button class="page-btn">16</button>
            <button class="page-btn"><i class="bi bi-chevron-right"></i></button>
        </div>
    </div>
    *@
</div>


<!-- =====================================================================
     MODAL — ADD NEW PATIENT
     ===================================================================== -->
<div class="modal fade" id="modalAddPatient" tabindex="-1" aria-labelledby="modalAddPatientLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title-wrap">
                    <div>
                        <h5 class="modal-title" id="modalAddPatientLabel">Add New Patient</h5>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" asp-controller="Patients" method="post" id="formAddPatient">
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <div class="form-section">
                        <h6 class="form-section-heading">Personal Information</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="addFullName" class="form-label">Full Name</label>
                                <input type="text" name="FullName" id="addFullName" class="form-control" placeholder="Enter full name" required />
                            </div>
                            <div class="col-md-6">
                                <label for="addAddress" class="form-label">Address</label>
                                <input type="text" name="Address" id="addAddress" class="form-control" placeholder="Enter address" required />
                            </div>
                            <div class="col-md-4">
                                <label for="addDateOfBirth" class="form-label">Date of Birth</label>
                                <input type="date" name="DateOfBirth" id="addDateOfBirth"
                                       class="form-control"
                                       min="@DateTime.Today.AddYears(-130).ToString("yyyy-MM-dd")"
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-md-4">
                                <label for="addAge" class="form-label">Age</label>
                                <input type="number" name="Age" id="addAge" class="form-control age-readonly" min="0" max="130" readonly />
                            </div>
                            <div class="col-md-4">
                                <label for="addMaritalStatus" class="form-label">Marital Status</label>
                                <select name="MaritalStatus" id="addMaritalStatus" class="form-select" required>
                                    <option value="">-- Select --</option>
                                    <option value="Single">Single</option>
                                    <option value="Married">Married</option>
                                    <option value="Widowed">Widowed</option>
                                    <option value="Separated">Separated</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="addReligion" class="form-label">Religion</label>
                                <input type="text" name="Religion" id="addReligion" class="form-control" placeholder="Enter religion" required />
                            </div>
                            <div class="col-md-4">
                                <label for="addOccupation" class="form-label">Occupation</label>
                                <input type="text" name="Occupation" id="addOccupation" class="form-control" placeholder="Enter occupation" required />
                            </div>
                            <div class="col-md-4">
                                <label for="addContactNo" class="form-label">Contact No.</label>
                                <input type="text" name="ContactNo" id="addContactNo" class="form-control" placeholder="Enter contact number" required />
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h6 class="form-section-heading">Obstetric Information</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="addLMP" class="form-label">LMP (Last Menstrual Period)</label>
                                <input type="date" name="LMP" id="addLMP" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label for="addAOG" class="form-label">AOG (Age of Gestation)</label>
                                <input type="text" name="AOG" id="addAOG" class="form-control" placeholder="Enter weeks" required />
                            </div>
                            <div class="col-md-4">
                                <label for="addEDC" class="form-label">EDC (Estimated Date of Confinement)</label>
                                <input type="date" name="EDC" id="addEDC" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label for="addMenarche" class="form-label">Menarche</label>
                                <input type="text" name="Menarche" id="addMenarche" class="form-control" placeholder="Age at first menstruation" required />
                            </div>
                            <div class="col-md-4">
                                <label for="addGravida" class="form-label">Gravida</label>
                                <input type="text" name="Gravida" id="addGravida" class="form-control" placeholder="Number of pregnancies" required />
                            </div>
                            <div class="col-md-4">
                                <label for="addTFAL" class="form-label">TFAL (Term, Full-term, Abortions, Living)</label>
                                <input type="text" name="TFAL" id="addTFAL" class="form-control" placeholder="e.g. 2-1-0-1" required />
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-dark">
                        <i class="bi bi-check-lg" aria-hidden="true"></i> Save Patient
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- =====================================================================
     MODAL — EDIT PATIENT
     ===================================================================== -->
<partial name="~/Views/Patients/Modals/_EditPatientModal.cshtml" />

<!-- =====================================================================
     MODAL — VIEW PATIENT DETAILS
     ===================================================================== -->
<div class="modal fade" id="modalViewPatientDetails" tabindex="-1" aria-labelledby="modalViewPatientDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title-wrap">
                    <div>
                        <h5 class="modal-title" id="modalViewPatientDetailsLabel">Patient Details</h5>
                        <p class="modal-subtitle" id="viewPatientHeaderSubtitle"></p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-section">
                    <h6 class="form-section-heading">Personal Information</h6>
                    <div class="detail-grid detail-grid-3">
                        <div class="detail-item">
                            <label>Full Name</label>
                            <div class="detail-value" id="viewDetailFullName">—</div>
                        </div>
                        <div class="detail-item">
                            <label>Address</label>
                            <div class="detail-value" id="viewDetailAddress">—</div>
                        </div>
                        <div class="detail-item">
                            <label>Contact No.</label>
                            <div class="detail-value" id="viewDetailContactNo">—</div>
                        </div>
                        <div class="detail-item">
                            <label>Date of Birth</label>
                            <div class="detail-value" id="viewDetailDOB">—</div>
                        </div>
                        <div class="detail-item">
                            <label>Age</label>
                            <div class="detail-value" id="viewDetailAge">—</div>
                        </div>
                        <div class="detail-item">
                            <label>Marital Status</label>
                            <div class="detail-value" id="viewDetailMaritalStatus">—</div>
                        </div>
                        <div class="detail-item">
                            <label>Religion</label>
                            <div class="detail-value" id="viewDetailReligion">—</div>
                        </div>
                        <div class="detail-item">
                            <label>Occupation</label>
                            <div class="detail-value" id="viewDetailOccupation">—</div>
                        </div>
                    </div>
                </div>
                <div class="form-section">
                    <h6 class="form-section-heading">Obstetric Information</h6>
                    <div class="detail-grid detail-grid-3">
                        <div class="detail-item">
                            <label>LMP (Last Menstrual Period)</label>
                            <div class="detail-value" id="viewDetailLMP">—</div>
                        </div>
                        <div class="detail-item">
                            <label>AOG (Age of Gestation)</label>
                            <div class="detail-value" id="viewDetailAOG">—</div>
                        </div>
                        <div class="detail-item">
                            <label>EDC (Estimated Date of Confinement)</label>
                            <div class="detail-value" id="viewDetailEDC">—</div>
                        </div>
                        <div class="detail-item">
                            <label>Menarche</label>
                            <div class="detail-value" id="viewDetailMenarche">—</div>
                        </div>
                        <div class="detail-item">
                            <label>Gravida</label>
                            <div class="detail-value" id="viewDetailGravida">—</div>
                        </div>
                        <div class="detail-item">
                            <label>TFAL (Term, Full-term, Abortions, Living)</label>
                            <div class="detail-value" id="viewDetailTFAL">—</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/patient/patient.js" asp-append-version="true"></script>
    <script>
        // Datos ug sayop gikan sa server (kung naa).
        const patientFormState = @Html.Raw(TempData["PatientForm"] as string ?? "null");

        // Auto-open modal if redirect back after failed validation
        @if (TempData["OpenAddModal"] != null)
        {
            <text>new bootstrap.Modal(document.getElementById('modalAddPatient')).show();
            applyPatientFormState('formAddPatient', patientFormState);</text>
        }

        @if (!string.IsNullOrWhiteSpace(openEditPatientId))
        {
            <text>openPatientEditModal(Number('@openEditPatientId'), patientFormState);</text>
        }
    </script>
}
