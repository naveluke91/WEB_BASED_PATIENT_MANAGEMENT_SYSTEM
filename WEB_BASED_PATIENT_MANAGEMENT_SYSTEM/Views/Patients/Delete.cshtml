@model WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.Patient
@{
    ViewData["Title"] = "Delete Patient";
}

<div class="form-page-header">
    <div class="page-heading">
        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Patient List
        </a>
        <h1>Delete Patient</h1>
    </div>
</div>

<div class="content-card card-pad card-narrow">
    <div class="callout callout-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <p>Are you sure you want to delete the following patient record? All related services, appointments, consultations, and medical records will also be permanently deleted.</p>
    </div>

    <!-- Summary of patient being deleted -->
    <div class="detail-grid detail-grid-spaced">
        <div class="detail-item">
            <label>Full Name</label>
            <div class="detail-value">@Model.FullName</div>
        </div>
        <div class="detail-item">
            <label>Contact No.</label>
            <div class="detail-value">@Model.ContactNo</div>
        </div>
        <div class="detail-item">
            <label>Age</label>
            <div class="detail-value">@Model.Age</div>
        </div>
        <div class="detail-item">
            <label>Address</label>
            <div class="detail-value">@Model.Address</div>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="form-actions">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="btn-cancel">Cancel</a>
        <button type="submit" class="btn-primary-dark btn-delete-confirm">
            <i class="bi bi-trash" aria-hidden="true"></i> Confirm Delete
        </button>
    </form>
</div>
