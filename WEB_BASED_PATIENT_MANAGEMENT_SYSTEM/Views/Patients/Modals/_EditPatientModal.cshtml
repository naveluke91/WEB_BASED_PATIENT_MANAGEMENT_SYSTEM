@{
    var minimumDateOfBirth = DateTime.Today.AddYears(-130).ToString("yyyy-MM-dd");
    var maximumDateOfBirth = DateTime.Today.ToString("yyyy-MM-dd");
}

<!-- Edit patient modal. Values are loaded from Patients/GetById before it opens. -->
<div class="modal fade" id="modalEditPatient" tabindex="-1" aria-labelledby="modalEditPatientLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title-wrap">
                    <div>
                        <h5 class="modal-title" id="modalEditPatientLabel">Edit Patient</h5>
                        <p class="modal-subtitle" id="editPatientSubtitle"></p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Edit" asp-controller="Patients" method="post" id="formEditPatient">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />

                <div class="modal-body">
                    <div class="form-section">
                        <h6 class="form-section-heading">Personal Information</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="editFullName" class="form-label">Full Name</label>
                                <input type="text" name="FullName" id="editFullName" class="form-control" placeholder="Enter full name" required />
                            </div>
                            <div class="col-md-6">
                                <label for="editAddress" class="form-label">Address</label>
                                <input type="text" name="Address" id="editAddress" class="form-control" placeholder="Enter address" required />
                            </div>
                            <div class="col-md-4">
                                <label for="editDateOfBirth" class="form-label">Date of Birth</label>
                                <input type="date" name="DateOfBirth" id="editDateOfBirth" class="form-control"
                                       min="@minimumDateOfBirth" max="@maximumDateOfBirth" required />
                            </div>
                            <div class="col-md-4">
                                <label for="editAge" class="form-label">Age</label>
                                <input type="number" name="Age" id="editAge" class="form-control age-readonly" min="0" max="130" readonly />
                            </div>
                            <div class="col-md-4">
                                <label for="editMaritalStatus" class="form-label">Marital Status</label>
                                <select name="MaritalStatus" id="editMaritalStatus" class="form-select" required>
                                    <option value="">-- Select --</option>
                                    <option value="Single">Single</option>
                                    <option value="Married">Married</option>
                                    <option value="Widowed">Widowed</option>
                                    <option value="Separated">Separated</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="editReligion" class="form-label">Religion</label>
                                <input type="text" name="Religion" id="editReligion" class="form-control" placeholder="Enter religion" required />
                            </div>
                            <div class="col-md-4">
                                <label for="editOccupation" class="form-label">Occupation</label>
                                <input type="text" name="Occupation" id="editOccupation" class="form-control" placeholder="Enter occupation" required />
                            </div>
                            <div class="col-md-4">
                                <label for="editContactNo" class="form-label">Contact No.</label>
                                <input type="text" name="ContactNo" id="editContactNo" class="form-control" placeholder="Enter contact number" required />
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h6 class="form-section-heading">Obstetric Information</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="editLMP" class="form-label">LMP (Last Menstrual Period)</label>
                                <input type="date" name="LMP" id="editLMP" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label for="editAOG" class="form-label">AOG (Age of Gestation)</label>
                                <input type="text" name="AOG" id="editAOG" class="form-control" placeholder="Enter weeks" required />
                            </div>
                            <div class="col-md-4">
                                <label for="editEDC" class="form-label">EDC (Estimated Date of Confinement)</label>
                                <input type="date" name="EDC" id="editEDC" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label for="editMenarche" class="form-label">Menarche</label>
                                <input type="text" name="Menarche" id="editMenarche" class="form-control" placeholder="Age at first menstruation" required />
                            </div>
                            <div class="col-md-4">
                                <label for="editGravida" class="form-label">Gravida</label>
                                <input type="text" name="Gravida" id="editGravida" class="form-control" placeholder="Number of pregnancies" required />
                            </div>
                            <div class="col-md-4">
                                <label for="editTFAL" class="form-label">TFAL (Term, Full-term, Abortions, Living)</label>
                                <input type="text" name="TFAL" id="editTFAL" class="form-control" placeholder="e.g. 2-1-0-1" required />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-dark">
                        <i class="bi bi-check-lg" aria-hidden="true"></i> Update Patient
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
