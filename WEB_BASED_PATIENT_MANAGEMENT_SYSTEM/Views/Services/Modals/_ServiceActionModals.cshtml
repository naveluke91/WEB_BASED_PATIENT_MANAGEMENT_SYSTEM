@{
    var patients = ViewBag.Patients as List<WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.Patient>
                   ?? new List<WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.Patient>();
}

<div class="modal fade" id="viewServiceModal" tabindex="-1" aria-labelledby="viewServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-md">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title-wrap">
                    <div>
                        <h5 class="modal-title" id="viewServiceModalLabel">Service Details</h5>
                        <p class="modal-subtitle" id="viewServiceSubtitle"></p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="detail-grid">
                    <div class="detail-item">
                        <label>Patient</label>
                        <div class="detail-value" id="viewServicePatient">—</div>
                    </div>
                    <div class="detail-item">
                        <label>Selected Service</label>
                        <div class="detail-value" id="viewServiceName">—</div>
                    </div>
                    <div class="detail-item">
                        <label>Price</label>
                        <div class="detail-value" id="viewServicePrice">—</div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancel" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editServiceModal" tabindex="-1" aria-labelledby="editServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-controller="Services" asp-action="Edit" method="post" id="editServiceForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editServiceId" />
                <input type="hidden" name="serviceName" id="editSelectedServiceInput" />

                <div class="modal-header">
                    <div class="modal-title-wrap">
                        <div>
                            <h5 class="modal-title" id="editServiceModalLabel">Edit Service</h5>
                            <p class="modal-subtitle">Update the selected patient or service.</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div id="editServiceError" class="alert alert-danger d-none mb-3" role="alert"></div>

                    <div class="form-section">
                        <h2 class="form-section-heading">Patient</h2>
                        <div class="svc-patient-select">
                            <label for="editPatientId" class="form-label">
                                Patient
                            </label>
                            <select name="patientId" id="editPatientId" class="form-select" required>
                                <option value="">-- Select registered patient --</option>
                                @foreach (var patient in patients)
                                {
                                    <option value="@patient.Id">@patient.FullName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-section">
                        <h2 class="form-section-heading">Select Service</h2>

                        <div class="svc-section-label">General Services</div>
                        <div class="svc-grid svc-grid-general">
                            <button type="button" class="svc-tile svc-tile-wide" data-service="Normal Delivery Fee &amp; Newborn Care Package" aria-pressed="false">
                                <span class="svc-name">Normal Delivery Fee &amp; Newborn Care Package</span>
                                <span class="svc-sub">(Including NBS &amp; Newborn Hearing Test)</span>
                                <span class="svc-price">PHP 15,000.00</span>
                            </button>
                            <button type="button" class="svc-tile" data-service="Prenatal" aria-pressed="false">
                                <span class="svc-name">Prenatal</span>
                                <span class="svc-price">PHP 100.00</span>
                            </button>
                        </div>

                        <div class="svc-section-label mt-3">Family Planning</div>
                        <div class="svc-grid svc-grid-family">
                            <button type="button" class="svc-tile" data-service="Implant" aria-pressed="false"><span class="svc-name">Implant</span><span class="svc-price svc-free">Free</span></button>
                            <button type="button" class="svc-tile" data-service="Implant Removal" aria-pressed="false"><span class="svc-name">Implant Removal</span><span class="svc-price">PHP 700.00</span></button>
                            <button type="button" class="svc-tile" data-service="DEPO" aria-pressed="false"><span class="svc-name">DEPO</span><span class="svc-price">PHP 200.00</span></button>
                            <button type="button" class="svc-tile" data-service="NORIFAM" aria-pressed="false"><span class="svc-name">NORIFAM</span><span class="svc-price">PHP 410.00</span></button>
                            <button type="button" class="svc-tile" data-service="IUD Insertion" aria-pressed="false"><span class="svc-name">IUD Insertion</span><span class="svc-price svc-free">Free</span></button>
                            <button type="button" class="svc-tile" data-service="IUD Removal" aria-pressed="false"><span class="svc-name">IUD Removal</span><span class="svc-price">PHP 600.00</span></button>
                            <button type="button" class="svc-tile" data-service="Anti-Tetanus Injection" aria-pressed="false"><span class="svc-name">Anti-Tetanus Injection</span><span class="svc-price">PHP 200.00</span></button>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-dark">
                        <i class="bi bi-check-lg" aria-hidden="true"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
