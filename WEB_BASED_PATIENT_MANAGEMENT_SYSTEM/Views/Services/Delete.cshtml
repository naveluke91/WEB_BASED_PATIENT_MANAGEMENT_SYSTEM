@model WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.Service
@{
    ViewData["Title"] = "Delete Service";
}

<div class="form-page-header">
    <div class="page-heading">
        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Services
        </a>
        <h1>Delete Service</h1>
    </div>
</div>

<div class="content-card card-pad card-narrow">
    <div class="callout callout-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <p>Delete the <strong>@Model.ServiceName</strong> service selected by <strong>@(Model.Patient?.FullName ?? "this patient")</strong>?</p>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="form-actions">
        @Html.AntiForgeryToken()
        <a asp-action="Index" class="btn-cancel">Cancel</a>
        <button type="submit" class="btn-primary-dark btn-delete-confirm">
            <i class="bi bi-trash" aria-hidden="true"></i> Confirm Delete
        </button>
    </form>
</div>
