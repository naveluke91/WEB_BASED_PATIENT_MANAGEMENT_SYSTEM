@model WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.Service
@{
    ViewData["Title"] = "Delete Service";
}

<div class="form-page-header">
    <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i></a>
    <h1>Delete Service</h1>
</div>

<div class="content-card p-4" style="max-width: 760px;">
    <p>Delete the <strong>@Model.ServiceName</strong> service selected by <strong>@(Model.Patient?.FullName ?? "this patient")</strong>?</p>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="form-actions mt-4">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-primary-dark btn-delete-confirm">Confirm Delete</button>
        <a asp-action="Index" class="btn-cancel ms-2">Cancel</a>
    </form>
</div>
