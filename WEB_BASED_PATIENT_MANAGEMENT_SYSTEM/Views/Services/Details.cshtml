@model WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.Service
@{
    ViewData["Title"] = "Service Details";
}

<div class="form-page-header">
    <div class="page-heading">
        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Services
        </a>
        <h1>Service Details</h1>
    </div>
</div>

<div class="content-card card-pad">
    <div class="detail-grid">
        <div class="detail-item">
            <label>Patient</label>
            <div class="detail-value">@(Model.Patient?.FullName ?? "Unknown")</div>
        </div>
        <div class="detail-item">
            <label>Service</label>
            <div class="detail-value">@Model.ServiceName</div>
        </div>
        <div class="detail-item">
            <label>Price</label>
            <div class="detail-value">&#8369; @Model.Price.ToString("N2")</div>
        </div>
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn-cancel">Back to List</a>
    </div>
</div>
