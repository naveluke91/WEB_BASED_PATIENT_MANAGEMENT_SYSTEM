@model WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.Service
@{
    ViewData["Title"] = "Service Details";
}

<div class="form-page-header">
    <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i></a>
    <h1>Service Details</h1>
</div>

<div class="content-card" style="max-width: 760px;">
    <div class="detail-grid detail-grid-spaced p-4">
        <div class="detail-item">
            <label>Patient</label>
            <div class="detail-value">@(Model.Patient?.FullName ?? "Unknown")</div>
        </div>
        <div class="detail-item">
            <label>Service</label>
            <div class="detail-value">@Model.ServiceName</div>
        </div>
        <div class="detail-item">
            <label>Price</label>
            <div class="detail-value">&#8369; @Model.Price.ToString("N2")</div>
        </div>
    </div>

    <div class="form-actions px-4 pb-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-primary-dark">Edit</a>
        <a asp-action="Index" class="btn-cancel ms-2">Back to List</a>
    </div>
</div>
