@model WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.Service
@{
    ViewData["Title"] = "Edit Service";
    var patients = ViewBag.Patients as List<WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.Patient>
                   ?? new List<WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.Patient>();
    var serviceNames = new[]
    {
        "Normal Delivery Fee & Newborn Care Package", "Prenatal", "Implant", "Implant Removal",
        "DEPO", "NORIFAM", "IUD Insertion", "IUD Removal", "Anti-Tetanus Injection"
    };
}

<div class="form-page-header">
    <div class="page-heading">
        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Services
        </a>
        <h1>Edit Service</h1>
    </div>
</div>

<div class="content-card card-pad">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="row g-3">
            <div class="col-md-6">
                <label for="servicePatientSelect" class="form-label">Patient</label>
                <select name="patientId" id="servicePatientSelect" class="form-select" required>
                    @foreach (var patient in patients)
                    {
                        if (patient.Id == Model.PatientId)
                        {
                            <option value="@patient.Id" selected>@patient.FullName</option>
                        }
                        else
                        {
                            <option value="@patient.Id">@patient.FullName</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label for="serviceNameSelect" class="form-label">Service</label>
                <select name="serviceName" id="serviceNameSelect" class="form-select" required>
                    @foreach (var serviceName in serviceNames)
                    {
                        if (serviceName == Model.ServiceName)
                        {
                            <option value="@serviceName" selected>@serviceName</option>
                        }
                        else
                        {
                            <option value="@serviceName">@serviceName</option>
                        }
                    }
                </select>
                <div class="form-text">The price is set automatically from the selected service.</div>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-primary-dark">
                <i class="bi bi-check-lg" aria-hidden="true"></i> Save Changes
            </button>
        </div>
    </form>
</div>
