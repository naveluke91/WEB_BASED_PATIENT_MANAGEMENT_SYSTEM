<div class="modal fade" id="editServiceModal" tabindex="-1" aria-labelledby="editServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:620px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px; overflow:hidden;">
            <form asp-controller="Services" asp-action="EditRegistration" method="post" id="editServiceRegistrationForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editServiceRecordId" />
                <input type="hidden" name="type" id="editServiceRecordType" />

                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <div>
                        <h5 class="modal-title fw-bold" id="editServiceModalLabel">Edit Service</h5>
                        <p class="text-muted small mb-0">Change the patient's selected service only.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body pt-3 px-4 pb-2">
                    <div id="editServiceError" class="alert alert-danger d-none mb-3"></div>

                    <div class="mb-3">
                        <label for="editServicePatientName" class="form-label small fw-semibold">Patient</label>
                        <input type="text" id="editServicePatientName" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label for="editSelectedService" class="form-label small fw-semibold">
                            Selected Service <span class="text-danger">*</span>
                        </label>
                        <select name="selectedService" id="editSelectedService" class="form-select" required>
                            <option value="">-- Select service --</option>
                            <option value="Normal Delivery Fee &amp; Newborn Care Package">Normal Delivery Fee &amp; Newborn Care Package</option>
                            <option value="Prenatal">Prenatal</option>
                            <option value="Implant">Implant</option>
                            <option value="Implant Removal">Implant Removal</option>
                            <option value="DEPO">DEPO</option>
                            <option value="NORIFAM">NORIFAM</option>
                            <option value="IUD Insertion">IUD Insertion</option>
                            <option value="IUD Removal">IUD Removal</option>
                            <option value="Anti-Tetanus Injection">Anti-Tetanus Injection</option>
                        </select>
                    </div>

                    <div class="rounded-3 border bg-light px-3 py-2">
                        <span class="text-muted small">Price</span>
                        <div class="fw-semibold" id="editServicePrice">—</div>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-3 pb-4 px-4">
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-dark">
                        <i class="bi bi-check-lg"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="viewServiceModal" tabindex="-1" aria-labelledby="viewServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:620px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px; overflow:hidden;">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <div>
                    <h5 class="modal-title fw-bold" id="viewServiceModalLabel">Service Details</h5>
                    <p class="text-muted small mb-0" id="viewServiceSubtitle"></p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body pt-3 px-4 pb-2">
                <div class="detail-grid">
                    <div class="detail-item">
                        <label>Patient</label>
                        <div class="detail-value" id="viewServicePatient">—</div>
                    </div>
                    <div class="detail-item">
                        <label>Selected Service</label>
                        <div class="detail-value" id="viewServiceName">—</div>
                    </div>
                    <div class="detail-item">
                        <label>Price</label>
                        <div class="detail-value" id="viewServicePrice">—</div>
                    </div>
                    <div class="detail-item">
                        <label>Registration Date</label>
                        <div class="detail-value" id="viewServiceDate">—</div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 pt-3 pb-4 px-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal" style="border-radius:8px;">Close</button>
            </div>
        </div>
    </div>
</div>
