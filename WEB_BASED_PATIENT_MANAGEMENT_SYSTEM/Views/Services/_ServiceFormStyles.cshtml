<style>
    /* Clinical record forms — Prenatal / Antenatal, Newborn, Family Planning.
       The paper-form structure is kept; colours and spacing use site.css tokens. */

    /* ── Record card ── */
    .pn-card {
        font-family: var(--font-sans);
        font-size: .8125rem;
        color: var(--text-primary);
    }

    .pn-main-title {
        position: relative;
        margin: 0 0 1.25rem;
        padding-bottom: .75rem;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-align: center;
        color: var(--brand-dark);
        border-bottom: 1px solid var(--border);
    }

    .pn-main-title::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: -2px;
        width: 56px;
        height: 3px;
        margin-left: -28px;
        border-radius: 3px;
        background: var(--brand-primary);
    }

    /* ── Paper-form rows ── */
    .pn-row {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: .5rem 1.5rem;
        margin-bottom: .6rem;
    }

    .pn-field {
        display: flex;
        align-items: flex-end;
        gap: .4rem;
        min-width: 120px;
    }

    .pn-label {
        padding-bottom: 3px;
        font-size: .75rem;
        font-weight: 600;
        color: var(--text-secondary);
        white-space: nowrap;
    }

    .pn-input,
    .pn-inline-input,
    .nb-blank {
        font-family: inherit;
        font-size: .8125rem;
        color: var(--text-primary);
        background: transparent;
        border: none;
        border-bottom: 1.5px solid #A9B8A3;
        border-radius: 4px 4px 0 0;
        outline: none;
        transition: border-color var(--transition), background-color var(--transition);
    }

    .pn-input {
        flex: 1;
        min-width: 60px;
        padding: 3px 6px;
    }

    .pn-input:hover:not(:disabled),
    .pn-inline-input:hover:not(:disabled),
    .nb-blank:hover:not(:disabled) {
        border-bottom-color: #7E9477;
    }

    .pn-input:focus,
    .pn-inline-input:focus,
    .nb-blank:focus {
        background: var(--brand-surface-soft);
        border-bottom-color: var(--brand-action);
    }

    .pn-radio-lbl {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: .8125rem;
        cursor: pointer;
    }

    .ml-2 { margin-left: .5rem; }

    hr.pn-divider {
        height: 0;
        margin: 1.75rem 0;
        background: none;
        border: 0;
        border-top: 1px dashed var(--border-strong);
        opacity: 1;
    }

    /* ── Visit / vitals / medication tables ── */
    .pn-visit-wrap {
        margin-top: .75rem;
        overflow-x: auto;
    }

    .pn-visit-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .8125rem;
    }

    .pn-visit-table th {
        padding: 7px 10px;
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .03em;
        text-align: left;
        color: var(--text-secondary);
        background: var(--bg-subtle);
        border: 1px solid var(--border);
    }

    .pn-visit-table td {
        padding: 2px 4px;
        background: var(--surface);
        border: 1px solid var(--border);
    }

    /* Remove button cell sits visually outside the table */
    .pn-visit-table td.td-remove {
        width: 40px;
        padding: 0 0 0 8px;
        background: transparent;
        border: none;
    }

    .pn-table-input {
        width: 100%;
        padding: 6px;
        font-family: inherit;
        font-size: .8125rem;
        color: var(--text-primary);
        background: transparent;
        border: none;
        border-radius: 4px;
        outline: none;
    }

    .pn-table-input:focus {
        background: var(--brand-surface-soft);
        box-shadow: inset 0 0 0 1.5px var(--brand-action);
    }

    .visit-remove-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        padding: 0;
        font-size: 1rem;
        color: var(--danger);
        background: var(--surface);
        border: 1px solid var(--danger-border);
        border-radius: 6px;
        cursor: pointer;
        transition: background-color var(--transition), color var(--transition), border-color var(--transition);
    }

    .visit-remove-btn:hover {
        color: #fff;
        background: var(--danger);
        border-color: var(--danger);
    }

    .visit-remove-btn:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px rgba(180, 35, 24, .2);
    }

    .pn-add-visit-row {
        margin-top: .6rem;
        text-align: right;
    }

    .btn-add-visit {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 32px;
        padding: 0 12px;
        font-family: inherit;
        font-size: .8125rem;
        font-weight: 600;
        color: var(--brand-text);
        background: var(--brand-surface);
        border: 1px solid #C9E7A0;
        border-radius: 6px;
        cursor: pointer;
        transition: background-color var(--transition), color var(--transition), border-color var(--transition);
    }

    .btn-add-visit:hover {
        color: #fff;
        background: var(--brand-action);
        border-color: var(--brand-action);
    }

    .btn-add-visit:focus-visible {
        outline: none;
        box-shadow: var(--focus-ring);
    }

    /* ── Assess / Classify table ── */
    .pn-assess-table {
        width: 100%;
        margin-top: 1rem;
        border-collapse: collapse;
        font-size: .8125rem;
    }

    .pn-assess-table th {
        padding: 8px 12px;
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-align: center;
        color: var(--brand-dark);
        background: var(--brand-surface);
        border: 1px solid #C9DDB5;
    }

    /* height:1px lets the classify textarea stretch to the row height */
    .pn-assess-table td {
        height: 1px;
        padding: 10px 12px;
        vertical-align: top;
        border: 1px solid var(--border);
    }

    .classify-col { width: 30%; }
    .pn-full-cell { padding: 10px 12px; }

    .pn-assess-title {
        margin-bottom: 6px;
        font-size: .8125rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .pn-assess-sub {
        margin: 8px 0 4px;
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: .02em;
        color: var(--text-secondary);
    }

    .pn-check-lbl {
        display: flex;
        align-items: flex-start;
        gap: 6px;
        margin-bottom: 3px;
        font-size: .8125rem;
        line-height: 1.45;
        cursor: pointer;
    }

    .pn-check-lbl input[type="checkbox"],
    .pn-check-lbl input[type="radio"] {
        flex-shrink: 0;
        margin-top: 3px;
    }

    .pn-classify,
    .pn-full-textarea {
        width: 100%;
        padding: 6px 8px;
        font-family: inherit;
        font-size: .8125rem;
        color: var(--text-primary);
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        border-radius: 6px;
        resize: vertical;
        transition: border-color var(--transition), box-shadow var(--transition), background-color var(--transition);
    }

    .pn-classify {
        height: 100%;
        min-height: 84px;
    }

    .pn-full-textarea {
        height: 56px;
        margin-bottom: 6px;
    }

    .pn-classify:focus,
    .pn-full-textarea:focus {
        outline: none;
        background: var(--surface);
        border-color: var(--brand-action);
        box-shadow: var(--focus-ring);
    }

    /* ── Inline question fields ── */
    .pn-inline-field {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
        margin-bottom: 4px;
        font-size: .8125rem;
    }

    .pn-inline-input {
        flex: 1;
        min-width: 100px;
        padding: 2px 4px;
    }

    .pn-short { flex: none; width: 110px; }

    .pn-sub-heading {
        margin: 6px 0 3px;
        font-size: .8rem;
        font-weight: 600;
        color: var(--text-secondary);
    }

    .pn-inline-row { flex-wrap: wrap; gap: 1rem; margin: 4px 0; }

    .pn-two-col {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: .75rem;
        font-size: .8125rem;
    }

    .pn-bullet-list { margin-top: 6px; font-size: .8125rem; line-height: 1.7; color: var(--text-secondary); }
    .pn-indent { padding-left: 1.2rem; font-size: .8rem; line-height: 1.6; color: var(--text-secondary); }

    /* ── Newborn consent ── */
    .nb-consent-text {
        margin-bottom: 1rem;
        font-size: .8125rem;
        line-height: 2;
        color: var(--text-primary);
    }

    .nb-blank-wrap { display: inline-flex; align-items: flex-end; }
    .nb-blank { padding: 0 4px; }

    .nb-pkg-table {
        width: 100%;
        margin-bottom: 1.25rem;
        border-collapse: collapse;
        font-size: .8125rem;
    }

    .nb-pkg-table td {
        padding: 9px 14px;
        color: var(--text-primary);
        border: 1px solid var(--border);
    }

    .nb-pkg-price {
        width: 170px;
        text-align: right;
        font-weight: 700;
        color: var(--brand-dark);
        background: var(--bg-subtle);
    }

    .nb-sig-row { display: flex; gap: 3rem; margin-top: 1rem; }
    .nb-sig-col { flex: 1; }
    .nb-sig-line { margin: 1.5rem 0 .25rem; border-bottom: 1.5px solid #A9B8A3; }

    /* ── Family Planning Form 1 ── */
    .fp-header-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 4px;
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .04em;
        color: var(--text-muted);
    }

    .fp-name-row { display: flex; gap: .6rem; margin-bottom: .5rem; }
    .fp-name-col { display: flex; flex-direction: column; align-items: center; }
    .fp-col-lbl { margin-top: 3px; font-size: .7rem; color: var(--text-muted); }

    .fp-client-box {
        display: flex;
        gap: 1.5rem;
        margin-top: 1rem;
        padding: 12px 16px;
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        border-radius: 10px;
    }

    .fp-client-left {
        flex: 1;
        padding-right: 1rem;
        border-right: 1px solid var(--border);
    }

    .fp-client-right { flex: 2; }

    .fp-method-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 2px 0;
    }

    .fp-section-hdr {
        margin: 1.5rem 0 .6rem;
        padding: 7px 12px;
        font-size: .8125rem;
        font-weight: 700;
        letter-spacing: .03em;
        color: var(--brand-dark);
        background: var(--brand-surface);
        border-left: 3px solid var(--brand-primary);
        border-radius: 0 6px 6px 0;
    }

    .fp-yn-table,
    .fp-sti-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .8125rem;
    }

    .fp-yn-table th,
    .fp-sti-table th {
        padding-bottom: 6px;
        font-size: .75rem;
        font-weight: 600;
        color: var(--text-muted);
    }

    .fp-sti-table th {
        text-align: left;
        border-bottom: 1px solid var(--border);
    }

    .fp-yn-table td,
    .fp-sti-table td {
        padding: 7px 4px;
        border-bottom: 1px solid var(--border-subtle);
    }

    .fp-yn-table tr:hover td,
    .fp-sti-table tr:hover td {
        background: #FAFDF6;
    }

    .fp-yn-cell { width: 60px; text-align: center; }

    .fp-pe-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .fp-pe-group {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-bottom: .85rem;
        font-size: .8125rem;
    }

    .fp-pe-title {
        margin-bottom: 3px;
        font-size: .8rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .fp-ack-box {
        margin-top: 1rem;
        padding: 1rem 1.25rem;
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        border-radius: 10px;
    }

    /* ── Read-only record view (disabled fieldset on ViewRecord) ── */
    .record-view input:disabled,
    .record-view select:disabled,
    .record-view textarea:disabled {
        color: var(--text-primary);
        -webkit-text-fill-color: var(--text-primary);
        opacity: 1;
        cursor: default;
    }

    .record-view textarea:disabled { resize: none; }

    .record-view input[type="checkbox"]:disabled,
    .record-view input[type="radio"]:disabled {
        opacity: .85;
    }

    @@media (max-width: 767.98px) {
        .pn-two-col,
        .fp-pe-two-col { grid-template-columns: 1fr; }

        .fp-client-box { flex-direction: column; }

        .fp-client-left {
            padding: 0 0 1rem;
            border-right: none;
            border-bottom: 1px solid var(--border);
        }

        .fp-method-grid { grid-template-columns: repeat(2, 1fr); }
        .nb-sig-row { flex-direction: column; gap: 1rem; }
        .classify-col { width: 38%; }
    }
</style>
