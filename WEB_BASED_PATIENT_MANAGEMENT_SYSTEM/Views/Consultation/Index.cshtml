@model WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.ConsultationPageViewModel
@{
    ViewData["Title"] = "Consultation";
}

@section Styles {
    <link rel="stylesheet" href="~/css/consultation/consultation.css" asp-append-version="true" />

    @* ==== [ST-CONSULT-0] START — SETUP: i-load ang skill test CSS (i-uncomment una ni) ==== *@
    @*
    <link rel="stylesheet" href="~/css/skilltestcss/st-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/skilltestcss/consultation.css" asp-append-version="true" />
    *@
    @* ==== [ST-CONSULT-0] END ==== *@
}

<div class="page-header">
    <div class="page-heading">
        <h1>Consultation</h1>
    </div>
</div>

<partial name="_PageAlerts" />

<div class="content-card">
    <div class="card-header-row">
        <h2 class="card-title">Consultation</h2>

        @* ==== [ST-CONSULT-2] START — Filter by Date ==== *@
        @*
        <select id="stConsultDatePreset" class="form-select st-filter" aria-label="Filter by date">
            <option value="">All Dates</option>
            <option value="today">Today</option>
            <option value="week">This Week</option>
            <option value="month">This Month</option>
        </select>
        *@
        @* ==== [ST-CONSULT-2] END ==== *@

        @* ==== [ST-CONSULT-4] START — Filter by Visit Type ug Service ==== *@
        @*
        <select id="stConsultVisitFilter" class="form-select st-filter" aria-label="Filter by visit type">
            <option value="">All Visit Types</option>
            <option value="Appointment">Appointment</option>
            <option value="Walk-In">Walk-In</option>
        </select>
        <select id="stConsultServiceFilter" class="form-select st-filter" aria-label="Filter by service">
            <option value="">All Services</option>
            @foreach (var name in Model.Queue.Select(q => q.ServiceType).Where(s => s != "—").Distinct().OrderBy(s => s))
            {
                <option value="@name">@name</option>
            }
        </select>
        *@
        @* ==== [ST-CONSULT-4] END ==== *@

        @* ==== [ST-CONSULT-3] START — Sort (Ascending / Descending) ==== *@
        @*
        <select id="stConsultSort" class="form-select st-filter" aria-label="Sort consultations">
            <option value="">Sort: Default (by status)</option>
            <option value="date:text:desc">Sort: Date (newest first)</option>
            <option value="date:text:asc">Sort: Date (oldest first)</option>
            <option value="name:text:asc">Sort: Name (A–Z)</option>
            <option value="name:text:desc">Sort: Name (Z–A)</option>
        </select>
        *@
        @* ==== [ST-CONSULT-3] END ==== *@

        @* ==== [ST-CONSULT-5] START — Pagination: pila ka row kada page ==== *@
        @*
        <select id="stConsultPageSize" class="form-select st-filter" aria-label="Rows per page">
            <option value="10">Show 10</option>
            <option value="25">Show 25</option>
            <option value="50">Show 50</option>
            <option value="0">Show all</option>
        </select>
        *@
        @* ==== [ST-CONSULT-5] END ==== *@

        <div class="search-box">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="text" id="consultationSearch" placeholder="Search patient by name or contact..." aria-label="Search consultations" />
        </div>
    </div>

    @* ==== [ST-CONSULT-1] START — Status tabs: All / Waiting / In Progress / Completed (naay ihap) ==== *@
    @*
    <div class="st-chips" id="stConsultTabs"></div>
    *@
    @* ==== [ST-CONSULT-1] END ==== *@

    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Contact</th>
                    @* ==== [ST-CONSULT-2] START — Date column ==== *@
                    @*
                    <th class="col-fit">Date</th>
                    *@
                    @* ==== [ST-CONSULT-2] END ==== *@
                    <th>Visit Type</th>
                    <th>Service</th>
                    @* ==== [ST-CONSULT-7] START — Attended By column ==== *@
                    @*
                    <th>Attended By</th>
                    *@
                    @* ==== [ST-CONSULT-7] END ==== *@
                    <th class="col-status">Status</th>
                    <th class="col-actions">Action</th>
                </tr>
            </thead>
            <tbody id="consultationTableBody">
                @if (!Model.Queue.Any())
                {
                    <tr>
                        <td colspan="6" class="table-empty">No consultations found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Queue)
                    {
                        var displayVisitType = item.AppointmentId.HasValue ? "Appointment" : "Walk-In";
                        var hasSelectedService = new[]
                        {
                            "Normal Delivery Fee & Newborn Care Package", "Prenatal", "Implant",
                            "Implant Removal", "DEPO", "NORIFAM", "IUD Insertion", "IUD Removal",
                            "Anti-Tetanus Injection",

                            // ==== [ST-SERVICE-9] START — Bag-ong service: Pap Smear ====
                            /*
                            "Pap Smear",
                            */
                            // ==== [ST-SERVICE-9] END ====
                        }.Contains(item.ServiceType);
                        var displayStatus = string.IsNullOrWhiteSpace(item.Status)
                            ? (item.AppointmentId.HasValue ? "Waiting" : "In Progress")
                            : item.Status;
                        var statusPillClass = displayStatus switch
                        {
                            "Waiting" => "status-pill-waiting",
                            "In Progress" => "status-pill-inprogress",
                            "Completed" => "status-pill-completed",
                            _ => "status-pill-waiting"
                        };
                        <tr class="patient-row" data-name="@item.PatientName.ToLower()" data-contact="@item.ContactNo">
                            <td class="cell-name">
                                @* ==== [ST-CONSULT-0] START — SETUP: datos sa row nga gamiton sa skilltestjs/consultation.js ==== *@
                                @*
                                <span class="st-data" hidden
                                      data-status="@displayStatus"
                                      data-date="@((item.SortDate.Year < 2000 ? DateTime.Today : item.SortDate).ToString("yyyy-MM-dd"))"
                                      data-sortdate="@item.SortDate.ToString("yyyy-MM-dd HH:mm")"
                                      data-visittype="@displayVisitType"
                                      data-service="@item.ServiceType"></span>
                                *@
                                @* ==== [ST-CONSULT-0] END ==== *@
                                @item.PatientName
                            </td>
                            <td class="cell-nowrap cell-center">@item.ContactNo</td>
                            @* ==== [ST-CONSULT-2] START — Date column (walk-in nga naghulat = karon) ==== *@
                            @*
                            <td class="col-fit cell-nowrap">@((item.SortDate.Year < 2000 ? DateTime.Today : item.SortDate).ToString("MMM dd, yyyy"))</td>
                            *@
                            @* ==== [ST-CONSULT-2] END ==== *@
                            <td class="cell-center">
                                <span class="visit-type">
                                    <i class="bi @(item.AppointmentId.HasValue ? "bi-calendar2-check" : "bi-person-walking")" aria-hidden="true"></i>
                                    @displayVisitType
                                </span>
                            </td>
                            <td>@(hasSelectedService ? item.ServiceType : "-")</td>
                            @* ==== [ST-CONSULT-7] START — Attended By column ==== *@
                            @*
                            <td>@(string.IsNullOrWhiteSpace(item.AttendedBy) ? "—" : item.AttendedBy)</td>
                            *@
                            @* ==== [ST-CONSULT-7] END ==== *@
                            <td class="col-status"><span class="status-pill @statusPillClass">@displayStatus</span></td>
                            <td class="col-actions">
                                <div class="action-btns">
                                    @if (displayStatus == "Waiting" && item.AppointmentId.HasValue && !hasSelectedService)
                                    {
                                        <a asp-controller="Services" asp-action="Index" asp-route-patientId="@item.PatientId" class="action-btn action-btn-primary" title="Register a service for this appointment">
                                            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Service
                                        </a>
                                    }
                                    else if (displayStatus == "Waiting" && item.AppointmentId.HasValue && item.AppointmentDate?.Date > DateTime.Today)
                                    {
                                        <button type="button" class="action-btn" disabled title="Scheduled for @item.AppointmentDate.Value.ToString("MMMM dd, yyyy")">
                                            <i class="bi bi-calendar-event" aria-hidden="true"></i> Starts @item.AppointmentDate.Value.ToString("MMM dd")
                                        </button>
                                    }
                                    else if (displayStatus == "Waiting" && item.AppointmentId.HasValue && hasSelectedService)
                                    {
                                        <button type="button" class="action-btn action-btn-primary start-appointment-btn"
                                                data-appointment-id="@item.AppointmentId"
                                                data-patient-id="@item.PatientId"
                                                data-patient-name="@item.PatientName"
                                                data-service="@(item.ServiceType == "—" ? "" : item.ServiceType)"
                                                data-bs-toggle="modal" data-bs-target="#beginConsultationModal">
                                            <i class="bi bi-play-fill" aria-hidden="true"></i> Start
                                        </button>
                                    }
                                    else if (displayStatus == "Waiting" && item.ServiceId.HasValue && hasSelectedService)
                                    {
                                        <button type="button" class="action-btn action-btn-primary start-appointment-btn"
                                                data-service-id="@item.ServiceId"
                                                data-patient-id="@item.PatientId"
                                                data-patient-name="@item.PatientName"
                                                data-service="@item.ServiceType"
                                                data-bs-toggle="modal" data-bs-target="#beginConsultationModal">
                                            <i class="bi bi-play-fill" aria-hidden="true"></i> Start
                                        </button>
                                    }
                                    else if (displayStatus == "In Progress" && item.ConsultationId.HasValue)
                                    {
                                        <a asp-action="Index" asp-route-openConsultationId="@item.ConsultationId" class="action-btn action-btn-primary">
                                            <i class="bi bi-pencil-square" aria-hidden="true"></i> Continue
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.ConsultationId" method="post" onsubmit="confirmDelete(event, this);" class="d-inline">
                                            <button type="submit" class="action-btn delete-btn" title="Delete consultation">
                                                <i class="bi bi-trash" aria-hidden="true"></i> Delete
                                            </button>
                                        </form>
                                    }
                                    else if (displayStatus == "Completed" && item.ConsultationId.HasValue && item.RecordId.HasValue && !string.IsNullOrWhiteSpace(item.RecordType))
                                    {
                                        <button type="button" class="action-btn"
                                                data-bs-toggle="modal" data-bs-target="#consultationRecordModal"
                                                data-url="@Url.Action("ViewRecord", new { id = item.ConsultationId })"
                                                data-record-title="@item.PatientName · @item.ServiceType">
                                            <i class="bi bi-journal-medical" aria-hidden="true"></i> View Record
                                        </button>
                                        @if (item.PaymentId.HasValue)
                                        {
                                            <a asp-controller="Billing" asp-action="Index" asp-route-paymentId="@item.PaymentId" class="action-btn" title="View payment transaction">
                                                <i class="bi bi-receipt-cutoff" aria-hidden="true"></i> View Payment
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Billing" asp-action="Index" asp-route-consultationId="@item.ConsultationId" class="action-btn action-btn-primary" title="Proceed to Billing">
                                                <i class="bi bi-receipt" aria-hidden="true"></i> Proceed to Billing
                                            </a>
                                        }

                                        @* ==== [ST-CONSULT-16] START — "Reopen" (Admin ra): ablihan balik ang completed record aron ma-edit ==== *@
                                        @*
                                        @if (User.IsInRole(UserRoles.Admin))
                                        {
                                            <form asp-action="Reopen" asp-route-id="@item.ConsultationId" method="post" onsubmit="confirmDelete(event, this);"
                                                  data-delete-message="Reopen this completed consultation so the record can be edited?">
                                                <button type="submit" class="action-btn" title="Reopen to edit the record">
                                                    <i class="bi bi-unlock" aria-hidden="true"></i> Reopen
                                                </button>
                                            </form>
                                        }
                                        *@
                                        @* ==== [ST-CONSULT-16] END ==== *@
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* ==== [ST-CONSULT-5] START — Pagination buttons (gi-fill sa skilltestjs/consultation.js) ==== *@
    @*
    <div id="stConsultPager" class="st-pager"></div>
    *@
    @* ==== [ST-CONSULT-5] END ==== *@
</div>

<div class="modal fade" id="beginConsultationModal" tabindex="-1" aria-labelledby="beginConsultationTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Begin" method="post" id="beginConsultationForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="appointmentId" id="beginAppointmentId" />
                <input type="hidden" name="serviceId" id="beginServiceId" />

                <div class="modal-header">
                    <div class="modal-title-wrap">
                        <div>
                            <h5 class="modal-title" id="beginConsultationTitle">Start Consultation</h5>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="startConfirmationMessage" class="modal-intro">Do you want to start this consultation?</p>
                    <div id="appointmentPatientNotice" class="alert alert-light border small d-none mb-3"></div>

                    <div class="mb-3 d-none">
                        <label for="beginPatientId" class="form-label">Registered Patient</label>
                        <select name="patientId" id="beginPatientId" class="form-select" required>
                            <option value="">Select patient</option>
                            @foreach (var patient in Model.Patients)
                            {
                                <option value="@patient.Id">@patient.FullName — @patient.ContactNo</option>
                            }
                        </select>
                    </div>

                    <div class="mb-2 d-none">
                        <label for="beginServiceType" class="form-label">Service</label>
                        <select name="serviceType" id="beginServiceType" class="form-select" required>
                            <option value="">Select service</option>
                            <option value="Prenatal">Prenatal</option>
                            @* The option tag helper encodes value itself; writing &amp; here would double-encode it and break the Start match. *@
                            <option value="Normal Delivery Fee & Newborn Care Package">Normal Delivery Fee &amp; Newborn Care Package</option>
                            <option value="Implant">Implant</option>
                            <option value="Implant Removal">Implant Removal</option>
                            <option value="DEPO">DEPO</option>
                            <option value="NORIFAM">NORIFAM</option>
                            <option value="IUD Insertion">IUD Insertion</option>
                            <option value="IUD Removal">IUD Removal</option>
                            <option value="Anti-Tetanus Injection">Anti-Tetanus Injection</option>
                            @* ==== [ST-SERVICE-9] START — Bag-ong service: Pap Smear ==== *@
                            @*
                            <option value="Pap Smear">Pap Smear</option>
                            *@
                            @* ==== [ST-SERVICE-9] END ==== *@
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">No</button>
                    <button type="submit" class="btn btn-primary">Yes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="consultationServiceModal" tabindex="-1" aria-hidden="true" data-open="@(Model.OpenConsultation != null ? "true" : "false")">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable modal-clinical">
        <div class="modal-content">
            <div class="modal-body clinical-form-body">
                @if (Model.OpenConsultation != null)
                {
                    <form asp-action="SaveService" method="post" id="consultationServiceForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="consultationId" value="@Model.OpenConsultation.Id" />
                        <input type="hidden" name="SelectedServices" id="selectedServicesInput" value="@Model.OpenConsultation.ServiceType" />
                        <input type="hidden" name="SelectedPatientId" id="selectedPatientIdInput" value="@Model.OpenConsultation.PatientId" />
                        <div class="d-none" aria-hidden="true">
                            <input type="text" id="patientSearchInput" autocomplete="off" />
                            <div id="patientDropdown"></div>
                        </div>

                        <div class="content-card mb-4 pn-card" id="prenatalRecordPanel"
                             style="display:@(Model.OpenConsultation.ServiceType == "Prenatal" ? "block" : "none");">
                            <partial name="~/Views/Consultation/Forms/_PrenatalForm.cshtml" model="Model.ServiceForm" />
                        </div>
                        <div class="content-card mb-4 pn-card" id="newbornPanel"
                             style="display:@(Model.OpenConsultation.ServiceType == "Normal Delivery Fee & Newborn Care Package" ? "block" : "none");">
                            <partial name="~/Views/Consultation/Forms/_NewbornForm.cshtml" model="Model.ServiceForm" />
                        </div>
                        <div class="content-card mb-4 pn-card" id="familyPlanningPanel"
                             style="display:@(Model.OpenConsultation.ServiceType != "Prenatal" && Model.OpenConsultation.ServiceType != "Normal Delivery Fee & Newborn Care Package" ? "block" : "none");">
                            <partial name="~/Views/Consultation/Forms/_FamilyPlanningForm.cshtml" model="Model.ServiceForm" />
                        </div>

                        <div class="clinical-form-actions">
                            <input type="hidden" name="saveLater" id="saveLaterInput" value="false" />
                            <button type="button" class="btn btn-light" id="saveLaterBtn">Save Later</button>
                            <button type="submit" class="btn btn-primary">Save Record</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="saveRecordConfirmModal" tabindex="-1" aria-labelledby="saveRecordConfirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title-wrap">
                    <div>
                        <h5 class="modal-title" id="saveRecordConfirmTitle">Save Consultation Record</h5>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to save this consultation record?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-primary-dark" id="saveRecordConfirmBtn">Save Record</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="consultationRecordModal" tabindex="-1" aria-labelledby="consultationRecordTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable modal-clinical">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title-wrap">
                    <div>
                        <h5 class="modal-title" id="consultationRecordTitle">Consultation Record</h5>
                        <p class="modal-subtitle" id="consultationRecordSubtitle"></p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body clinical-form-body" id="consultationRecordBody"></div>
            <div class="modal-footer">
                @* ==== [ST-CONSULT-15] START — Print Record button ==== *@
                @*
                <button type="button" class="btn-cancel" id="stPrintRecord">
                    <i class="bi bi-printer" aria-hidden="true"></i> Print Record
                </button>
                *@
                @* ==== [ST-CONSULT-15] END ==== *@
                <button type="button" class="btn-cancel" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.consultationPageData = {
            patients: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                (ViewBag.Patients as List<WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.Patient> ?? new List<WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.Patient>())
                .Select(p => new { id = p.Id, name = p.FullName }))),
            initialPatientId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((int?)ViewBag.InitialPatientId)),
            initialPatientName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string?)ViewBag.InitialPatientName)),
            initialService: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string?)ViewBag.InitialService)),
            fieldRules: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ClinicalRules)),
            clinicalErrors: @Html.Raw(TempData["ClinicalErrors"] as string ?? "null")
        };
    </script>
    <script src="~/js/consultation/consultation.js" asp-append-version="true"></script>

    @* ==== [ST-CONSULT-0] START — SETUP: i-load ang skill test JS (i-uncomment una ni) ==== *@
    @*
    <script src="~/js/skilltestjs/st-core.js" asp-append-version="true"></script>
    <script src="~/js/skilltestjs/consultation.js" asp-append-version="true"></script>
    *@
    @* ==== [ST-CONSULT-0] END ==== *@
}
