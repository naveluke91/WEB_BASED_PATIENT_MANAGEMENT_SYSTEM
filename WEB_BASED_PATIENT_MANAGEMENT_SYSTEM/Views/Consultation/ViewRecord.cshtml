@model WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.ConsultationPageViewModel
@{
    ViewData["Title"] = "Consultation Record";
    var consultation = Model.OpenConsultation;
}

<div class="form-page-header">
    <div class="page-heading">
        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Consultation
        </a>
        <h1>Consultation Record</h1>
        @if (consultation?.Patient != null)
        {
            <p class="subtitle">@consultation.Patient.FullName &middot; @consultation.ServiceType</p>
        }
    </div>
    @if (consultation != null)
    {
        <div class="page-actions">
            <span class="status-pill status-pill-completed">@consultation.Status</span>
        </div>
    }
</div>

@if (consultation != null)
{
    <fieldset disabled="disabled" class="record-fieldset record-view">
        <div class="content-card mb-4 pn-card" style="display:@(consultation.ServiceType == "Prenatal" ? "block" : "none");">
            <partial name="~/Views/Services/_PrenatalForm.cshtml" model="Model.ServiceForm" />
        </div>
        <div class="content-card mb-4 pn-card" style="display:@(consultation.ServiceType == "Normal Delivery Fee & Newborn Care Package" ? "block" : "none");">
            <partial name="~/Views/Services/_NewbornForm.cshtml" model="Model.ServiceForm" />
        </div>
        <div class="content-card mb-4 pn-card" style="display:@(consultation.ServiceType != "Prenatal" && consultation.ServiceType != "Normal Delivery Fee & Newborn Care Package" ? "block" : "none");">
            <partial name="~/Views/Services/_FamilyPlanningForm.cshtml" model="Model.ServiceForm" />
        </div>
    </fieldset>
}

<div class="form-actions form-actions-bare">
    <a asp-action="Index" class="btn-cancel">Back to Consultation List</a>
</div>

<partial name="~/Views/Services/_ServiceFormStyles.cshtml" />
