@{
    ViewData["Title"] = "Access Denied";
}

<div class="content-card error-card">
    <div class="error-icon" aria-hidden="true"><i class="bi bi-shield-lock"></i></div>
    <h1>Access denied</h1>
    <p class="error-lead">Your account can't open that page.</p>
    <p>This page isn't available to your role. Ask the Admin if your account needs a change.</p>
    <a asp-controller="Patients" asp-action="Index" class="btn-primary-dark">Back to Patients</a>
</div>
