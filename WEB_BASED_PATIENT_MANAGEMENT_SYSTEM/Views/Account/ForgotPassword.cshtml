@model WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";

    // Every error renders under its own field (red border + small text), never as a page-level alert.
    // asp-for already adds "input-validation-error" from ModelState on its own; the manual class below
    // only fills the one gap ModelState can't cover: TempData["PasswordResetError"], set by the
    // redirect-based cases (rate limit, Resend Code, an expired reset session).
    var usernameError = ViewData.ModelState["Username"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var modelEmailError = ViewData.ModelState["Email"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var tempDataEmailError = TempData["PasswordResetError"] as string;
    var emailError = modelEmailError ?? tempDataEmailError;
    var codeError = ViewData.ModelState["Code"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<h1 class="auth-title">Forgot Password</h1>

<form asp-action="ForgotPassword" method="post">
    <div class="auth-field">
        <label asp-for="Username" class="form-label">Username</label>
        <input asp-for="Username" class="form-control" maxlength="50" autocomplete="username" autofocus required />
        @if (usernameError != null)
        {
            <span class="field-validation-error text-danger">@usernameError</span>
        }
    </div>

    <div class="auth-field">
        <label asp-for="Email" class="form-label">Email Address</label>
        <input asp-for="Email" type="email" class="form-control @(modelEmailError == null && tempDataEmailError != null ? "input-validation-error" : "")"
               maxlength="256" autocomplete="email" required />
        @if (emailError != null)
        {
            <span class="field-validation-error text-danger">@emailError</span>
        }
    </div>

    <button type="submit" class="btn-primary-dark auth-submit">Send Verification Code</button>
</form>

@* The Verification Code field stays visible on this card at all times (never hidden/toggled). *@
<form asp-action="VerifyCode" method="post" class="mt-3">
    <div class="auth-field">
        <label for="Code" class="form-label">Verification Code</label>
        <input type="text" name="Code" id="Code" class="form-control text-center @(codeError != null ? "input-validation-error" : "")"
               inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" placeholder="000000" />
        @if (codeError != null)
        {
            <span class="field-validation-error text-danger">@codeError</span>
        }
    </div>

    <button type="submit" class="btn-primary-dark auth-submit">Verify Code</button>
</form>

<form asp-action="ResendCode" method="post" class="text-center mt-3">
    <button type="submit" class="btn btn-link p-0">Resend Code</button>
</form>

<div class="text-center mt-3">
    <a asp-action="Login">Back to Sign In</a>
</div>
