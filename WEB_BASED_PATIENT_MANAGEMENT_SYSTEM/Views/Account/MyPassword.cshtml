@* ==== [ST-ACCOUNT-3] START — Change Password page para sa naka-login (My Account) ==== *@
@* Kini nga page kay gikan sa AccountController.MyPassword (naka-comment sab). *@
@*
@model StChangeMyPasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .ToDictionary(entry => entry.Key, entry => entry.Value!.Errors.First().ErrorMessage);
    string? ErrorFor(string key) => errors.TryGetValue(key, out var message) ? message : null;
}

<div class="page-header">
    <div class="page-heading">
        <h1>Change Password</h1>
    </div>
</div>

<div class="content-card st-mypassword-card">
    <form asp-action="MyPassword" method="post" class="card-pad">
        <div class="mb-3">
            <label for="myCurrentPassword" class="form-label">Current Password</label>
            <input type="password" name="CurrentPassword" id="myCurrentPassword" maxlength="100"
                   class="form-control @(ErrorFor("CurrentPassword") != null ? "input-validation-error" : "")"
                   autocomplete="current-password" required />
            <div class="field-validation-error text-danger">@ErrorFor("CurrentPassword")</div>
        </div>
        <div class="mb-3">
            <label for="myNewPassword" class="form-label">New Password</label>
            <input type="password" name="NewPassword" id="myNewPassword" maxlength="100"
                   class="form-control @(ErrorFor("NewPassword") != null ? "input-validation-error" : "")"
                   autocomplete="new-password" placeholder="At least 8 characters" required />
            <div class="field-validation-error text-danger">@ErrorFor("NewPassword")</div>
        </div>
        <div class="mb-4">
            <label for="myConfirmPassword" class="form-label">Confirm New Password</label>
            <input type="password" name="ConfirmPassword" id="myConfirmPassword" maxlength="100"
                   class="form-control @(ErrorFor("ConfirmPassword") != null ? "input-validation-error" : "")"
                   autocomplete="new-password" required />
            <div class="field-validation-error text-danger">@ErrorFor("ConfirmPassword")</div>
        </div>
        <div class="d-flex gap-2 justify-content-end">
            <a asp-controller="Patients" asp-action="Index" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-primary-dark"><i class="bi bi-check-lg" aria-hidden="true"></i> Save New Password</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/skilltestjs/account.js" asp-append-version="true"></script>
}
*@
@* ==== [ST-ACCOUNT-3] END ==== *@
