@model WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_AuthLayout";
}

@* Human sa reset sa password: usbon una ang temporary password. *@
<h1 class="auth-title">Change your password</h1>
<p class="auth-subtitle">Your password was reset. Create a new password before using the system.</p>

<form asp-action="ChangePassword" method="post">
    <div class="auth-field">
        <label for="changeNewPassword" class="form-label">New Password</label>
        <input asp-for="NewPassword" type="password" id="changeNewPassword" class="form-control"
               maxlength="100" autocomplete="new-password" placeholder="At least 8 characters" autofocus />
        <span asp-validation-for="NewPassword"></span>
    </div>

    <div class="auth-field">
        <label for="changeConfirmPassword" class="form-label">Confirm New Password</label>
        <input asp-for="ConfirmPassword" type="password" id="changeConfirmPassword" class="form-control"
               maxlength="100" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit" class="btn-primary-dark auth-submit">Save New Password</button>
</form>

<form asp-action="Logout" method="post" class="text-center mt-3">
    <button type="submit" class="btn btn-link p-0">Sign out</button>
</form>
