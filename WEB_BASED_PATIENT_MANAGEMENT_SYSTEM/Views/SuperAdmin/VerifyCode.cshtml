@model VerifyCodeViewModel
@{
    ViewData["Title"] = "Verify Recovery Code";
    Layout = "_SuperAdminLayout";
}

<h1 class="sa-title">Enter recovery code</h1>
<p class="sa-subtitle">Enter the 8-digit code from the recovery Gmail. The code expires in 10 minutes and stops working after 5 wrong tries.</p>

<form asp-controller="SuperAdmin" asp-action="VerifyCode" method="post" id="saVerifyForm" novalidate>
    <div class="sa-field">
        <label for="saRecoveryCode" class="sa-label">Recovery Code</label>
        <input asp-for="Code" id="saRecoveryCode" class="form-control sa-input sa-input-code" inputmode="numeric"
               autocomplete="one-time-code" maxlength="8" placeholder="00000000" autofocus />
        <span asp-validation-for="Code"></span>
    </div>

    <button type="submit" class="sa-btn sa-btn-primary sa-btn-block">
        <i class="bi bi-shield-check" aria-hidden="true"></i> Verify Code
    </button>
</form>

<div class="sa-card-links">
    <a asp-controller="SuperAdmin" asp-action="ForgotPassword">Request a new code</a>
    <a asp-controller="SuperAdmin" asp-action="Login">Back to sign in</a>
</div>
