@model SuperAdminSettingsViewModel
@{
    ViewData["Title"] = "Settings";

    // Gi-reject nga porma gikan sa server (markahan ang mga field).
    var saForm = TempData["SaForm"] as string;
    var notice = TempData["SaNotice"] as string;
    var error = TempData["SaError"] as string;
    var busy = Context.Request.Query["busy"] == "1";
}

<div class="page-header">
    <div class="page-heading">
        <h1>Settings</h1>
    </div>
</div>

@if (busy || !string.IsNullOrWhiteSpace(notice) || !string.IsNullOrWhiteSpace(error))
{
    <div class="page-alerts">
        @if (busy)
        {
            <div class="alert alert-light" role="alert">
                <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                <span>Too many attempts. Please wait a minute and try again.</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(notice))
        {
            <div class="alert alert-success" role="status">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <span>@notice</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <span>@error</span>
            </div>
        }
    </div>
}

@* Ang SuperAdmin account ra; walay password o hash nga ipakita. *@
<div class="content-card mb-4">
    <div class="card-header-row">
        <h2 class="card-title">SuperAdmin Account</h2>
    </div>
    <div class="p-4">
        <div class="detail-grid">
            <div class="detail-item">
                <label>Username</label>
                <div class="detail-value">@Model.Username</div>
            </div>
            <div class="detail-item">
                <label>Recovery Gmail</label>
                <div class="detail-value">
                    @if (string.IsNullOrEmpty(Model.RecoveryEmail))
                    {
                        <span class="text-muted">Not set. Forgot Password can't send a code until you add one.</span>
                    }
                    else
                    {
                        @Model.RecoveryEmail
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="content-card h-100">
            <div class="card-header-row">
                <h2 class="card-title">Change Username</h2>
            </div>
            <form asp-controller="SuperAdmin" asp-action="ChangeUsername" method="post" id="saUsernameForm" class="p-4" novalidate>
                <div class="mb-3">
                    <label for="saUsernameCurrent" class="form-label">Current Password</label>
                    <input type="password" name="CurrentPassword" id="saUsernameCurrent" class="form-control" maxlength="100" autocomplete="current-password" />
                </div>
                <div class="mb-4">
                    <label for="saNewUsername" class="form-label">New Username</label>
                    <input type="text" name="NewUsername" id="saNewUsername" class="form-control" maxlength="50" autocomplete="off" />
                </div>
                <button type="submit" class="btn-primary-dark"><i class="bi bi-check-lg" aria-hidden="true"></i> Save Username</button>
            </form>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="content-card h-100">
            <div class="card-header-row">
                <h2 class="card-title">Change Password</h2>
            </div>
            <form asp-controller="SuperAdmin" asp-action="ChangeOwnPassword" method="post" id="saPasswordForm" class="p-4" novalidate>
                <div class="mb-3">
                    <label for="saPasswordCurrent" class="form-label">Current Password</label>
                    <input type="password" name="CurrentPassword" id="saPasswordCurrent" class="form-control" maxlength="100" autocomplete="current-password" />
                </div>
                <div class="mb-3">
                    <label for="saPasswordNew" class="form-label">New Password</label>
                    <input type="password" name="NewPassword" id="saPasswordNew" class="form-control" maxlength="100" autocomplete="new-password" />
                </div>
                <div class="mb-3">
                    <label for="saPasswordConfirm" class="form-label">Confirm Password</label>
                    <input type="password" name="ConfirmPassword" id="saPasswordConfirm" class="form-control" maxlength="100" autocomplete="new-password" />
                </div>
                @* Parehas nga mga lagda sa password sa ubang SuperAdmin pages. *@
                <div class="text-muted small mb-4"><partial name="_PasswordRules" /></div>
                <button type="submit" class="btn-primary-dark"><i class="bi bi-check-lg" aria-hidden="true"></i> Save Password</button>
            </form>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="content-card h-100">
            <div class="card-header-row">
                <h2 class="card-title">Recovery Gmail</h2>
            </div>
            <form asp-controller="SuperAdmin" asp-action="ChangeRecoveryEmail" method="post" id="saRecoveryForm" class="p-4" novalidate>
                <div class="mb-3">
                    <label for="saRecoveryCurrent" class="form-label">Current Password</label>
                    <input type="password" name="CurrentPassword" id="saRecoveryCurrent" class="form-control" maxlength="100" autocomplete="current-password" />
                </div>
                <div class="mb-3">
                    <label for="saRecoveryEmailInput" class="form-label">Recovery Gmail</label>
                    <input type="email" name="RecoveryEmail" id="saRecoveryEmailInput" class="form-control" maxlength="256"
                           autocomplete="email" placeholder="name@gmail.com" value="@Model.RecoveryEmail" />
                </div>
                <p class="text-muted small mb-4">Used only for Forgot Password on the SuperAdmin sign-in.</p>
                <button type="submit" class="btn-primary-dark"><i class="bi bi-check-lg" aria-hidden="true"></i> Save Recovery Gmail</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.superAdminPageData = { form: @Html.Raw(saForm ?? "null") };
    </script>
    <script src="~/js/superadmin/superadmin.js" asp-append-version="true"></script>
}
