@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    ViewData["SaCard"] = true;
}

<h1 class="sa-title">Forgot password</h1>
<p class="sa-subtitle">Enter the recovery Gmail registered to the SuperAdmin account. A recovery code will be sent to it.</p>

<form asp-controller="SuperAdmin" asp-action="ForgotPassword" method="post" id="saForgotForm" novalidate>
    <div class="sa-field">
        <label for="saRecoveryEmail" class="sa-label">Recovery Gmail</label>
        <input asp-for="Email" type="email" id="saRecoveryEmail" class="form-control sa-input" autocomplete="email" maxlength="256" placeholder="name@gmail.com" autofocus />
        <span asp-validation-for="Email"></span>
    </div>

    <button type="submit" class="sa-btn sa-btn-primary sa-btn-block">
        <i class="bi bi-envelope-arrow-up" aria-hidden="true"></i> Send Recovery Code
    </button>
</form>

<div class="sa-card-links">
    <a asp-controller="SuperAdmin" asp-action="VerifyCode">I already have a code</a>
    <a asp-controller="SuperAdmin" asp-action="Login">Back to sign in</a>
</div>
