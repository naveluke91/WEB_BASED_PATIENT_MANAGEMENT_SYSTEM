@model (string? Notice, string? Error, bool Busy)
@* Mga mensahe sa SuperAdmin pages (walay sensitibo nga datos). *@
@if (Model.Busy)
{
    <div class="sa-alert sa-alert-warn" role="alert">
        <i class="bi bi-hourglass-split" aria-hidden="true"></i>
        <span>Too many attempts. Please wait a minute and try again.</span>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="sa-alert sa-alert-error" role="alert">
        <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
        <span>@Model.Error</span>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <div class="sa-alert sa-alert-info" role="status">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
        <span>@Model.Notice</span>
    </div>
}
