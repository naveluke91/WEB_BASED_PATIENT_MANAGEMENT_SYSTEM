@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Set a New Password";
    Layout = "_SuperAdminLayout";
}

<h1 class="sa-title">Set a new password</h1>
<p class="sa-subtitle">You signed in with a temporary password. Create a new password before continuing.</p>

<form asp-controller="SuperAdmin" asp-action="ChangePassword" method="post" id="saChangePasswordForm" novalidate>
    <div class="sa-field">
        <label for="saNewPassword" class="sa-label">New Password</label>
        <input asp-for="NewPassword" type="password" id="saNewPassword" class="form-control sa-input" autocomplete="new-password" maxlength="100" autofocus />
        <span asp-validation-for="NewPassword"></span>
    </div>

    <div class="sa-field">
        <label for="saConfirmPassword" class="sa-label">Confirm New Password</label>
        <input asp-for="ConfirmPassword" type="password" id="saConfirmPassword" class="form-control sa-input" autocomplete="new-password" maxlength="100" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <partial name="_PasswordRules" />

    <button type="submit" class="sa-btn sa-btn-primary sa-btn-block">
        <i class="bi bi-check2-circle" aria-hidden="true"></i> Save New Password
    </button>
</form>

<form asp-controller="Account" asp-action="Logout" method="post" class="sa-card-links">
    <button type="submit" class="sa-link-btn">Sign out</button>
</form>
