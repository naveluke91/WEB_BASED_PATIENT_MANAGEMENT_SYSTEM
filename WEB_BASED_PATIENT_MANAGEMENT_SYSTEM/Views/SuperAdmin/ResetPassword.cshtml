@model RecoveryResetViewModel
@{
    ViewData["Title"] = "Reset Password";
    ViewData["SaCard"] = true;
}

<h1 class="sa-title">Create a new password</h1>
<p class="sa-subtitle">The code was accepted. Create a new password for the SuperAdmin account.</p>

<form asp-controller="SuperAdmin" asp-action="ResetPassword" method="post" id="saResetPasswordForm" novalidate>
    @* Single-use reset token (dili ang recovery code). *@
    <input type="hidden" name="Token" value="@Model.Token" />

    <div class="sa-field">
        <label for="saRecoveryNewPassword" class="sa-label">New Password</label>
        <input asp-for="NewPassword" type="password" id="saRecoveryNewPassword" class="form-control sa-input" autocomplete="new-password" maxlength="100" autofocus />
        <span asp-validation-for="NewPassword"></span>
    </div>

    <div class="sa-field">
        <label for="saRecoveryConfirmPassword" class="sa-label">Confirm New Password</label>
        <input asp-for="ConfirmPassword" type="password" id="saRecoveryConfirmPassword" class="form-control sa-input" autocomplete="new-password" maxlength="100" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <partial name="_PasswordRules" />

    <button type="submit" class="sa-btn sa-btn-primary sa-btn-block">
        <i class="bi bi-check2-circle" aria-hidden="true"></i> Save New Password
    </button>
</form>

<div class="sa-card-links">
    <a asp-controller="SuperAdmin" asp-action="Login">Back to sign in</a>
</div>
