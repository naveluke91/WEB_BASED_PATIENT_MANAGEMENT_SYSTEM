<!DOCTYPE html>

<html lang="en-GB">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Materniva</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/patients.css" asp-append-version="true" />

</head>

<body>

    <div class="dashboard-wrapper">

        <aside class="sidebar">

            <div class="sidebar-logo">
                <div class="sidebar-logo-mark">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>
                <div class="sidebar-logo-text">
                    <h2>Materniva</h2>
                    <p>Española Birthing Home</p>
                </div>
            </div>

            <nav class="sidebar-nav">
                @{
                    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                }

                <a asp-controller="Patients" asp-action="Index" class="nav-item @(controller == "Patients" ? "active" : "")">
                    <i class="bi bi-people"></i>
                    <span>Patients</span>
                </a>

                <!-- Services direct link -->
                <a asp-controller="Services" asp-action="Index" class="nav-item @(controller == "Services" ? "active" : "")">
                    <i class="bi bi-clipboard2-pulse"></i>
                    <span>Services</span>
                </a>

                <!-- Appointments direct link -->
                <a asp-controller="Appointments" asp-action="Index" class="nav-item @(controller == "Appointments" ? "active" : "")">
                    <i class="bi bi-calendar2-check"></i>
                    <span>Appointments</span>
                </a>

                <!-- Consultation direct link -->
                <a asp-controller="Consultation" asp-action="Index" class="nav-item @(controller == "Consultation" ? "active" : "")">
                    <i class="bi bi-file-earmark-medical"></i>
                    <span>Consultation</span>
                </a>
            </nav>



            <a href="#" class="nav-item logout-link">

                <i class="bi bi-box-arrow-left"></i>

                <span>Logout</span>

            </a>

        </aside>



        <div class="main-content">

            @RenderBody()

        </div>

    </div>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
