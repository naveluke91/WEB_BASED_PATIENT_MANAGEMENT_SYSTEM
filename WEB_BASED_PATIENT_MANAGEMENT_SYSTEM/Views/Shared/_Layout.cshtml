@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@inject WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Data.ApplicationDbContext NotificationDbContext
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();

    // The clinic logo is shown when it exists in wwwroot/images; otherwise a
    // neutral brand mark keeps the sidebar intact.
    const string logoFileName = "espanola-birthing-home-logo.jpg";
    var hasLogo = !string.IsNullOrEmpty(HostEnvironment.WebRootPath)
                  && System.IO.File.Exists(System.IO.Path.Combine(HostEnvironment.WebRootPath, "images", logoFileName));

    // Ang naka-login nga account (gikan sa claims).
    var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name;
    var displayRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    // Users: Admin ra.
    var canManageUsers = User.IsInRole(UserRoles.Admin);

    // Notification bell: today's and tomorrow's appointments only (not cancelled, not completed,
    // not already past, not already read by this account). Marking one read never touches the Appointment.
    var now = DateTime.Now;
    var tomorrow = now.Date.AddDays(1);
    var currentUserAccountId = int.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var uid) ? uid : (int?)null;
    var readAppointmentIds = currentUserAccountId.HasValue
        ? NotificationDbContext.NotificationReads
            .Where(r => r.UserAccountId == currentUserAccountId.Value)
            .Select(r => r.AppointmentId)
            .ToHashSet()
        : new HashSet<int>();
    var upcomingAppointments = User.Identity?.IsAuthenticated == true
        ? NotificationDbContext.Appointments
            .Where(a => a.Status != "Cancelled" && a.AppointmentDate >= now.Date && a.AppointmentDate <= tomorrow
                && !NotificationDbContext.Consultations.Any(c => c.AppointmentId == a.Id && c.Status == "Completed"))
            .OrderBy(a => a.AppointmentDate).ThenBy(a => a.AppointmentTime)
            .ToList()
            .Where(a => a.AppointmentDate.Date > now.Date || a.AppointmentDate.Date.Add(a.AppointmentTime) >= now)
            .Where(a => !readAppointmentIds.Contains(a.Id))
            .Take(10)
            .ToList()
        : new List<Appointment>();

    // ==== [ST-NOTIF-3] START — Notification: pasyente nga manganak (EDC) sulod sa 7 ka adlaw ====
    /*
    var stDueSoonPatients = User.Identity?.IsAuthenticated == true
        ? NotificationDbContext.Patients
            .Where(p => p.EDC >= now.Date && p.EDC <= now.Date.AddDays(7))
            .OrderBy(p => p.EDC)
            .Take(10)
            .ToList()
        : new List<Patient>();
    */
    // ==== [ST-NOTIF-3] END ====

    // ==== [ST-NOTIF-4] START — Notification: completed consultations nga wala pa nabayran ====
    /*
    var stUnpaidCount = User.Identity?.IsAuthenticated == true
        ? NotificationDbContext.Consultations
            .Count(c => c.Status == "Completed" && !NotificationDbContext.Payments.Any(p => p.ConsultationId == c.Id))
        : 0;
    */
    // ==== [ST-NOTIF-4] END ====
}
<!DOCTYPE html>

<html lang="en-GB">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color" content="#0A3D09" />

    <title>@ViewData["Title"] · Española Birthing Home</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* ==== [ST-GENERAL-0] START — SETUP: i-load ang skilltestcss/general.css ==== *@
    @*
    <link rel="stylesheet" href="~/css/skilltestcss/general.css" asp-append-version="true" />
    *@
    @* ==== [ST-GENERAL-0] END ==== *@

    @* ==== [ST-NOTIF-0] START — SETUP: i-load ang skilltestcss/notification.css ==== *@
    @*
    <link rel="stylesheet" href="~/css/skilltestcss/notification.css" asp-append-version="true" />
    *@
    @* ==== [ST-NOTIF-0] END ==== *@

    @* ==== [ST-ACCOUNT-0] START — SETUP: i-load ang skilltestcss/account.css (para sa Change Password link/page) ==== *@
    @*
    <link rel="stylesheet" href="~/css/skilltestcss/account.css" asp-append-version="true" />
    *@
    @* ==== [ST-ACCOUNT-0] END ==== *@

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="dashboard-wrapper">

        <aside class="sidebar" aria-label="Main navigation">

            <div class="sidebar-brand">
                <span class="brand-logo">
                    @if (hasLogo)
                    {
                        <img src="~/images/@logoFileName" asp-append-version="true" alt="Española Birthing Home logo" />
                    }
                    else
                    {
                        <i class="bi bi-heart-pulse-fill brand-logo-fallback" aria-hidden="true"></i>
                    }
                </span>
                <span class="brand-text">
                    <span class="brand-name">Española</span>
                    <span class="brand-sub">Birthing Home</span>
                </span>
            </div>

            <nav class="sidebar-nav">
                @* ==== [ST-DASHBOARD-1] START — Dashboard link sa sidebar ==== *@
                @*
                <a asp-controller="Dashboard" asp-action="Index" title="Dashboard"
                   class="nav-item @(controller == "Dashboard" ? "active" : "")"
                   aria-current="@(controller == "Dashboard" ? "page" : null)">
                    <i class="bi bi-speedometer2" aria-hidden="true"></i>
                    <span>Dashboard</span>
                </a>
                *@
                @* ==== [ST-DASHBOARD-1] END ==== *@

                <a asp-controller="Patients" asp-action="Index" title="Patients"
                   class="nav-item @(controller == "Patients" ? "active" : "")"
                   aria-current="@(controller == "Patients" ? "page" : null)">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span>Patients</span>
                </a>

                <a asp-controller="Services" asp-action="Index" title="Services"
                   class="nav-item @(controller == "Services" ? "active" : "")"
                   aria-current="@(controller == "Services" ? "page" : null)">
                    <i class="bi bi-clipboard2-pulse" aria-hidden="true"></i>
                    <span>Services</span>
                </a>

                <a asp-controller="Appointments" asp-action="Index" title="Appointments"
                   class="nav-item @(controller == "Appointments" ? "active" : "")"
                   aria-current="@(controller == "Appointments" ? "page" : null)">
                    <i class="bi bi-calendar2-check" aria-hidden="true"></i>
                    <span>Appointments</span>
                </a>

                <a asp-controller="Consultation" asp-action="Index" title="Consultation"
                   class="nav-item @(controller == "Consultation" ? "active" : "")"
                   aria-current="@(controller == "Consultation" ? "page" : null)">
                    <i class="bi bi-file-earmark-medical" aria-hidden="true"></i>
                    <span>Consultation</span>
                </a>

                <a asp-controller="Billing" asp-action="Index" title="Payment/Billing"
                   class="nav-item @(controller == "Billing" ? "active" : "")"
                   aria-current="@(controller == "Billing" ? "page" : null)">
                    <i class="bi bi-receipt" aria-hidden="true"></i>
                    <span>Billing</span>
                </a>

                <a asp-controller="Reports" asp-action="Index" title="Reports"
                   class="nav-item @(controller == "Reports" ? "active" : "")"
                   aria-current="@(controller == "Reports" ? "page" : null)">
                    <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                    <span>Reports</span>
                </a>

                @* Ipakita ra sa Admin. *@
                @if (canManageUsers)
                {
                    <a asp-controller="UserManagement" asp-action="Index" title="Users"
                       class="nav-item @(controller == "UserManagement" ? "active" : "")"
                       aria-current="@(controller == "UserManagement" ? "page" : null)">
                        <i class="bi bi-person-gear" aria-hidden="true"></i>
                        <span>Users</span>
                    </a>
                }

                @* ==== [ST-USER-8] START — Audit Trail link sa sidebar (Admin ra) ==== *@
                @*
                @if (canManageUsers)
                {
                    <a asp-controller="UserManagement" asp-action="AuditLog" title="Audit Trail"
                       class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "AuditLog" ? "active" : "")">
                        <i class="bi bi-journal-text" aria-hidden="true"></i>
                        <span>Audit Trail</span>
                    </a>
                }
                *@
                @* ==== [ST-USER-8] END ==== *@

                @* ==== [ST-USER-9] START — Reports ug Billing para sa Admin ra: itago ang link sa Staff ==== *@
                @*
                @if (!canManageUsers)
                {
                    <style>
                        .sidebar-nav .nav-item[title="Reports"],
                        .sidebar-nav .nav-item[title="Payment/Billing"] { display: none; }
                    </style>
                }
                *@
                @* ==== [ST-USER-9] END ==== *@

            </nav>

            <div class="sidebar-footer">
                @* Logout pinaagi sa POST (naay AntiForgeryToken). *@
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="nav-item logout-link" title="Logout">
                        <i class="bi bi-box-arrow-left" aria-hidden="true"></i>
                        <span>Logout</span>
                    </button>
                </form>
            </div>

        </aside>

        <div class="main-content">

            <header class="topbar">
                <div class="topbar-context">
                    <span>Materniva</span>
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    <strong>@ViewData["Title"]</strong>
                </div>
                <div class="topbar-right">
                    <div class="dropdown notification-bell">
                        <button type="button" class="notification-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                            @if (upcomingAppointments.Count > 0)
                            {
                                <span class="notification-badge">@upcomingAppointments.Count</span>
                            }
                        </button>
                        <div class="dropdown-menu dropdown-menu-end notification-dropdown">
                            <div class="notification-dropdown-header">Notifications</div>
                            @* ==== [ST-NOTIF-2] START — "Mark all as read" nga button ==== *@
                            @*
                            @if (upcomingAppointments.Count > 0)
                            {
                                <button type="button" class="st-notif-mark-all" id="stMarkAllRead">
                                    <i class="bi bi-check2-all" aria-hidden="true"></i> Mark all as read
                                </button>
                            }
                            *@
                            @* ==== [ST-NOTIF-2] END ==== *@
                            @if (upcomingAppointments.Count == 0)
                            {
                                <div class="notification-empty">No upcoming appointments or follow-up visits.</div>
                            }
                            else
                            {
                                <div class="notification-list">
                                    @foreach (var appt in upcomingAppointments)
                                    {
                                        <div class="notification-item" data-appointment-id="@appt.Id" role="button" tabindex="0">
                                            <div class="notification-item-name">@appt.PatientName</div>
                                            <div class="notification-item-type">Appointment</div>
                                            <div class="notification-item-date">@appt.AppointmentDate.ToString("MMMM d, yyyy") &middot; @appt.FormattedTime</div>
                                        </div>
                                    }
                                </div>
                            }

                            @* ==== [ST-NOTIF-3] START — Listahan sa manganak (EDC) sulod sa 7 ka adlaw ==== *@
                            @*
                            @if (stDueSoonPatients.Count > 0)
                            {
                                <div class="st-notif-subheader">Due to deliver (next 7 days)</div>
                                @foreach (var duePatient in stDueSoonPatients)
                                {
                                    <a class="notification-item st-notif-link" asp-controller="Patients" asp-action="Index">
                                        <div class="notification-item-name">@duePatient.FullName</div>
                                        <div class="notification-item-type">EDC</div>
                                        <div class="notification-item-date">@duePatient.EDC?.ToString("MMMM d, yyyy")</div>
                                    </a>
                                }
                            }
                            *@
                            @* ==== [ST-NOTIF-3] END ==== *@

                            @* ==== [ST-NOTIF-4] START — Pila ka consultation ang wala pa nabayran ==== *@
                            @*
                            @if (stUnpaidCount > 0)
                            {
                                <div class="st-notif-subheader">Billing</div>
                                <a class="notification-item st-notif-link" asp-controller="Billing" asp-action="Index">
                                    <div class="notification-item-name">@stUnpaidCount unpaid consultation@(stUnpaidCount == 1 ? "" : "s")</div>
                                    <div class="notification-item-type">Click to record the payment</div>
                                </a>
                            }
                            *@
                            @* ==== [ST-NOTIF-4] END ==== *@
                        </div>
                    </div>
                    @* Antiforgery token for the notification-read AJAX call in site.js (no visible form). *@
                    <form id="notificationReadTokenForm" class="d-none">@Html.AntiForgeryToken()</form>
                    <div class="topbar-user">
                        <span class="user-name">@displayName</span>
                        @if (!string.IsNullOrEmpty(displayRole))
                        {
                            <span class="user-role">@displayRole</span>
                        }
                    </div>
                    @* ==== [ST-ACCOUNT-3] START — "Change Password" link para sa naka-login (My Account) ==== *@
                    @*
                    <a asp-controller="Account" asp-action="MyPassword" class="st-topbar-link" title="Change Password">
                        <i class="bi bi-key" aria-hidden="true"></i><span>Change Password</span>
                    </a>
                    *@
                    @* ==== [ST-ACCOUNT-3] END ==== *@
                </div>
            </header>

            <main id="main-content" class="page-body" tabindex="-1">
                @RenderBody()
            </main>

        </div>

    </div>

    @* Shared confirmation modal for destructive actions (replaces window.confirm()); see confirmDelete/showConfirmModal in site.js. *@
    <div class="modal fade" id="confirmActionModal" tabindex="-1" aria-labelledby="confirmActionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-title-wrap">
                        <div>
                            <h5 class="modal-title" id="confirmActionModalLabel">Confirm Delete</h5>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="confirmActionMessage" class="mb-0"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn-primary-dark" id="confirmActionConfirmBtn">
                        <i class="bi bi-trash" aria-hidden="true"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* ==== [ST-GENERAL-0] START — SETUP: i-load ang skilltestjs/general.js ==== *@
    @*
    <script src="~/js/skilltestjs/general.js" asp-append-version="true"></script>
    *@
    @* ==== [ST-GENERAL-0] END ==== *@

    @* ==== [ST-NOTIF-0] START — SETUP: i-load ang skilltestjs/notification.js ==== *@
    @*
    <script src="~/js/skilltestjs/notification.js" asp-append-version="true"></script>
    *@
    @* ==== [ST-NOTIF-0] END ==== *@

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
