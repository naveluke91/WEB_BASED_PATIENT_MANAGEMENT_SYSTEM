@using System.Security.Claims
@{
    // SuperAdmin layout: lahi nga theme; walay link gikan sa clinic UI.
    var isCard = ViewData["SaCard"] as bool? == true;
    var showConsole = !isCard && User.IsInRole(UserRoles.SuperAdmin);
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var displayName = User.FindFirst(ClaimTypes.GivenName)?.Value;
    var username = User.Identity?.Name;
    var notice = TempData["SaNotice"] as string;
    var error = TempData["SaError"] as string;
    var busy = Context.Request.Query["busy"] == "1";
}
<!DOCTYPE html>

<html lang="en-GB">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0B1628" />

    <title>@ViewData["Title"] · SuperAdmin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/superadmin/superadmin.css" asp-append-version="true" />
</head>

<body class="sa-body @(isCard ? "sa-body-auth" : "sa-body-console")">

    @if (showConsole)
    {
        <header class="sa-topbar">
            <div class="sa-topbar-inner">
                <a asp-controller="SuperAdmin" asp-action="ManageUsers" class="sa-brand">
                    <span class="sa-brand-mark" aria-hidden="true"><i class="bi bi-shield-lock-fill"></i></span>
                    <span class="sa-brand-text">
                        <span class="sa-brand-name">SuperAdmin</span>
                        <span class="sa-brand-sub">Española Birthing Home</span>
                    </span>
                </a>

                <nav class="sa-nav" aria-label="SuperAdmin navigation">
                    <a asp-controller="SuperAdmin" asp-action="ManageUsers"
                       class="sa-nav-link @(action == "ManageUsers" ? "active" : "")"
                       aria-current="@(action == "ManageUsers" ? "page" : null)">
                        <i class="bi bi-people" aria-hidden="true"></i><span>Manage Users</span>
                    </a>
                    <a asp-controller="SuperAdmin" asp-action="Settings"
                       class="sa-nav-link @(action == "Settings" ? "active" : "")"
                       aria-current="@(action == "Settings" ? "page" : null)">
                        <i class="bi bi-gear" aria-hidden="true"></i><span>Settings</span>
                    </a>
                </nav>

                <div class="sa-account">
                    <span class="sa-account-avatar" aria-hidden="true"><i class="bi bi-person-badge"></i></span>
                    <span class="sa-account-text">
                        <span class="sa-account-name">@displayName</span>
                        <span class="sa-account-user">@username</span>
                    </span>
                    @* Logout pinaagi sa POST (naay AntiForgeryToken). *@
                    <form asp-controller="SuperAdmin" asp-action="Logout" method="post">
                        <button type="submit" class="sa-btn sa-btn-ghost" title="Logout">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>Logout</span>
                        </button>
                    </form>
                </div>
            </div>
        </header>

        <main id="main-content" class="sa-main">
            <partial name="~/Views/SuperAdmin/_Alerts.cshtml" model="(notice, error, busy)" />
            @RenderBody()
        </main>
    }
    else
    {
        <main id="main-content" class="sa-auth">
            <div class="sa-card">
                <div class="sa-card-brand">
                    <span class="sa-brand-mark" aria-hidden="true"><i class="bi bi-shield-lock-fill"></i></span>
                    <span class="sa-brand-text">
                        <span class="sa-brand-name">SuperAdmin</span>
                        <span class="sa-brand-sub">Española Birthing Home</span>
                    </span>
                </div>
                <partial name="~/Views/SuperAdmin/_Alerts.cshtml" model="(notice, error, busy)" />
                @RenderBody()
            </div>
        </main>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/superadmin/superadmin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
