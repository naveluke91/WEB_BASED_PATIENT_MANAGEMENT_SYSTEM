@{
    // Layout sa SuperAdmin login ug recovery pages (wala pa naka-login): usa ka card.
    // Human sa login, ang SuperAdmin naggamit sa parehas nga clinic layout (_Layout).
    var notice = TempData["SaNotice"] as string;
    var error = TempData["SaError"] as string;
    var busy = Context.Request.Query["busy"] == "1";
}
<!DOCTYPE html>

<html lang="en-GB">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0F172A" />

    <title>@ViewData["Title"] · SuperAdmin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/superadmin/superadmin.css" asp-append-version="true" />
</head>

<body class="sa-body">

    <main id="main-content" class="sa-auth">
        <div class="sa-card">
            <div class="sa-card-brand">
                <span class="sa-brand-mark" aria-hidden="true"><i class="bi bi-shield-lock-fill"></i></span>
                <span class="sa-brand-text">
                    <span class="sa-brand-name">SuperAdmin</span>
                    <span class="sa-brand-sub">Española Birthing Home</span>
                </span>
            </div>
            <partial name="~/Views/SuperAdmin/_Alerts.cshtml" model="(notice, error, busy)" />
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/superadmin/superadmin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
