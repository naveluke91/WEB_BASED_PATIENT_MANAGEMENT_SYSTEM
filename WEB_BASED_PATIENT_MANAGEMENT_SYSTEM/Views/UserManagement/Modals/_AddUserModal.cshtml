@model WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.UserManagementPageViewModel
<!-- Add User: the password is hashed by the server; it is never stored or shown as text. -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="UserManagement" asp-action="Create" method="post" id="addUserForm">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <div class="modal-title-wrap">
                        <div>
                            <h5 class="modal-title" id="addUserModalLabel">@(Model.IsSuperAdmin ? "Add Account" : "Add User")</h5>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div id="addUserError" class="alert alert-danger d-none mb-3" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label for="addUserFullName" class="form-label">Full Name</label>
                            <input type="text" name="FullName" id="addUserFullName" class="form-control"
                                   maxlength="150" placeholder="Enter full name" required />
                        </div>
                        @* Admin: walay Role, ang bag-ong account kanunay Staff (server).
                           SuperAdmin: Admin o Staff ra; walay SuperAdmin nga opsyon. *@
                        <div class="@(Model.IsSuperAdmin ? "col-sm-6" : "col-12")">
                            <label for="addUserUsername" class="form-label">Username</label>
                            <input type="text" name="Username" id="addUserUsername" class="form-control"
                                   minlength="3" maxlength="50" pattern="[A-Za-z0-9._\-]+"
                                   title="Letters, numbers, dots, dashes and underscores only"
                                   autocomplete="off" placeholder="e.g. mdelacruz" required />
                        </div>
                        @if (Model.IsSuperAdmin)
                        {
                            <div class="col-sm-6">
                                <label for="addUserRole" class="form-label">Role</label>
                                <select name="Role" id="addUserRole" class="form-select" required>
                                    <option value="">-- Select Role --</option>
                                    @foreach (var role in UserRoles.Assignable)
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="col-sm-6">
                            <label for="addUserPassword" class="form-label">Password</label>
                            <input type="password" name="Password" id="addUserPassword" class="form-control"
                                   minlength="8" maxlength="100" autocomplete="new-password"
                                   placeholder="At least 8 characters" required />
                        </div>
                        <div class="col-sm-6">
                            <label for="addUserConfirmPassword" class="form-label">Confirm Password</label>
                            <input type="password" name="ConfirmPassword" id="addUserConfirmPassword" class="form-control"
                                   maxlength="100" autocomplete="new-password" placeholder="Re-enter password" required />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-dark" id="addUserSubmit">
                        <i class="bi bi-check-lg" aria-hidden="true"></i> @(Model.IsSuperAdmin ? "Create Account" : "Save User")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
