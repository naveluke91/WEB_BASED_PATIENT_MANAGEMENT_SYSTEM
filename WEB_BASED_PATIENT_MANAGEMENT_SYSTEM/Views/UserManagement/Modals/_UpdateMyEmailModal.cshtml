@model WEB_BASED_PATIENT_MANAGEMENT_SYSTEM.Models.UserManagementPageViewModel
<div class="modal fade" id="updateMyEmailModal" tabindex="-1" aria-labelledby="updateMyEmailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="UserManagement" asp-action="UpdateOwnEmail" method="post" id="updateMyEmailForm">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <div class="modal-title-wrap">
                        <div>
                            <h5 class="modal-title" id="updateMyEmailModalLabel">Update My Email</h5>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div id="updateMyEmailError" class="alert alert-danger d-none mb-3" role="alert"></div>
                    <p class="text-muted small">This email address is used only for password recovery.</p>

                    <div class="row g-3">
                        <div class="col-12">
                            <label for="updateMyEmail" class="form-label">Email Address</label>
                            <input type="email" name="Email" id="updateMyEmail" class="form-control"
                                   maxlength="256" autocomplete="email" placeholder="name@example.com" required />
                        </div>
                        <div class="col-12">
                            <label for="updateMyEmailCurrentPassword" class="form-label">Current Password</label>
                            <input type="password" name="CurrentPassword" id="updateMyEmailCurrentPassword" class="form-control"
                                   maxlength="100" autocomplete="current-password" required />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-dark" id="updateMyEmailSubmit">
                        <i class="bi bi-check-lg" aria-hidden="true"></i> Save Email
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
