@* Reset Password (SuperAdmin ra): temporary password, usbon sa sunod nga login. Ang password dili ma-store o ipakita. *@
<div class="modal fade" id="resetUserModal" tabindex="-1" aria-labelledby="resetUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="UserManagement" asp-action="ResetPassword" method="post" id="resetUserForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="resetUserId" />

                <div class="modal-header">
                    <div class="modal-title-wrap">
                        <div>
                            <h5 class="modal-title" id="resetUserModalLabel">Reset Password</h5>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div id="resetUserError" class="alert alert-danger d-none mb-3" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <span class="form-label d-block">Account Name</span>
                            <div class="fw-semibold" id="resetUserName"></div>
                        </div>
                        <div class="col-sm-6">
                            <label for="resetUserPassword" class="form-label">New Password</label>
                            <input type="password" name="NewPassword" id="resetUserPassword" class="form-control"
                                   minlength="8" maxlength="100" autocomplete="new-password"
                                   placeholder="At least 8 characters" required />
                        </div>
                        <div class="col-sm-6">
                            <label for="resetUserConfirmPassword" class="form-label">Confirm Password</label>
                            <input type="password" name="ConfirmPassword" id="resetUserConfirmPassword" class="form-control"
                                   maxlength="100" autocomplete="new-password" placeholder="Re-enter password" required />
                        </div>
                        <div class="col-12 pt-3">
                            <p class="mb-0 text-muted small">
                                <i class="bi bi-info-circle" aria-hidden="true"></i>
                                This is a temporary password. The user must change it at their next sign-in.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-dark" id="resetUserSubmit">
                        <i class="bi bi-key" aria-hidden="true"></i> Reset Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
